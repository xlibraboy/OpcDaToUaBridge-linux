# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/

# .NET user secrets and local config
appsettings.*.json
!appsettings.json

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# JetBrains Rider
.idea/
*.DotSettings.user

# PKI artifacts — keep directory structure, not secrets
pki/own/private/
# App-level local PKI (cert + private key generated at first run)
src/OpcBridge.App/pki/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Publish output (build artifacts)
publish/
publish.tmp/
publish.bak.*/
publish*.tar.gz

# Release build output: portable zips from scripts/msi/build-portable.sh, and the
# WiX fragments scripts/msi/harvest.py generates into build/wix/ for the MSI.
build/
dist/
__pycache__/
*.pyc

# Runtime state (generated at runtime)
mappings.json

# Local NuGet package cache
.nuget/


# Worktrees (user-requested location for git worktrees)
worktrees/
# Subagent-driven development worktrees
.worktrees/
#Avalonia build task cache
.avalonia-build-tasks/
**/.avalonia-build-tasks/

# Agent skills — bodies are restored from skills-lock.json (see scripts/install-agent-skills.sh)
# Commit skills-lock.json so every PC gets the same skill set; do not commit skill file trees.
.agents/
.pi/
.nuget-cache/

# Command Code — personal project settings for this repo.
# Shared rules live in .commandcode/settings.json (committed); keep per-developer overrides out of git.
.commandcode/settings.local.json
