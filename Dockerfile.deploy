FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/OpcBridge.App/OpcBridge.App.csproj -c Release -r win-x64 --self-contained -o /out

FROM python:3.12-slim AS docs
WORKDIR /src
COPY . .
RUN pip install --no-cache-dir -q mkdocs-material && mkdocs build --site-dir /site

FROM scratch AS out
COPY --from=build /out /
COPY --from=docs /site /docs-site
