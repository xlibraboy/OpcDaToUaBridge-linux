<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpcBridge.Core\OpcBridge.Core.csproj" />
    <ProjectReference Include="..\OpcBridge.Da\OpcBridge.Da.csproj" />
    <ProjectReference Include="..\OpcBridge.Ua\OpcBridge.Ua.csproj" />
    <ProjectReference Include="..\OpcBridge.Mqtt\OpcBridge.Mqtt.csproj" />
    <ProjectReference Include="..\OpcBridge.Influx\OpcBridge.Influx.csproj" />
    <ProjectReference Include="..\OpcBridge.Client\OpcBridge.Client.csproj" />
    <ProjectReference Include="..\OpcBridge.Drivers.Melsec\OpcBridge.Drivers.Melsec.csproj" />
    <ProjectReference Include="..\OpcBridge.Drivers.S7\OpcBridge.Drivers.S7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The release notes are shipped inside the assembly and served at
       /api/changelog, so the dashboard and CHANGELOG.md can never disagree. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="OpcBridge.App.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpcBridge.LoadTest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Workstation GC, not the Server GC Microsoft.NET.Sdk.Web gives a web app by
         default. Server GC allocates a heap and a dedicated collection thread per core
         (four of each on the plant host) with noticeably larger segments, and it sizes
         for throughput rather than for the footprint of a bridge that mostly idles —
         this app spends ~0.1 s of CPU per ten minutes with a few hundred tags mapped.
         Measured on WORKSTAT02 (4 GB RAM, 4 cores, x86 so ~2 GB of address space),
         both arms freshly restarted, same 259-tag workload and window:

           Server GC      private 99 -> 115 MB and still climbing (+1.71 MB/min),
                          working set 152 -> 171 MB, virtual ~825 MB
           Workstation GC private 53.5 -> 53.7 MB (flat), working set ~115 MB,
                          virtual ~378 MB

         i.e. -53% private bytes, -33% working set, and half the virtual address space
         — which is the part that matters in a 32-bit process built for 32-bit OPC DA
         COM servers. See docs/ram-measurement.md (issue #27). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Icon resource embedded in the published apphost, so Explorer, the Start Menu
         shortcut and the taskbar show the bridge instead of the generic .NET blank.
         Generated by scripts/icons/make-icons.py. -->
    <ApplicationIcon>Assets/opcbridge-server.ico</ApplicationIcon>
    <!-- Version / InformationalVersion come from Directory.Build.props. -->
  </PropertyGroup>

</Project>
