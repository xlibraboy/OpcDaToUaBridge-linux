<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:OpcBridge.Hmi.ViewModels.Widgets"
             x:Class="OpcBridge.Hmi.Controls.Widgets.NumericWidgetView"
             x:DataType="widgets:NumericWidgetViewModel">
  <Border Background="{DynamicResource WidgetSurfaceBrush}"
          CornerRadius="4"
          Padding="8,4"
          PointerPressed="OnPointerPressed">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Label}" Opacity="0.8" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" />
      <TextBlock Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource WarnFgBrush}" IsVisible="{Binding IsUnbound}" />
    </StackPanel>
  </Border>
</UserControl>
