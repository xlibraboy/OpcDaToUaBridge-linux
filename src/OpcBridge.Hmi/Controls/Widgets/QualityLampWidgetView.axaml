<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:OpcBridge.Hmi.ViewModels.Widgets"
             x:Class="OpcBridge.Hmi.Controls.Widgets.QualityLampWidgetView"
             x:DataType="widgets:QualityLampWidgetViewModel">
  <Border Background="#333337"
          CornerRadius="4"
          Padding="8,4"
          PointerPressed="OnPointerPressed">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Ellipse Width="18" Height="18" VerticalAlignment="Center">
        <Ellipse.Styles>
          <Style Selector="Ellipse">
            <Setter Property="Fill" Value="#888888" />
          </Style>
        </Ellipse.Styles>
      </Ellipse>
      <StackPanel>
        <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.8" Foreground="#CCCCCC" />
        <TextBlock Text="{Binding QualityText}" Foreground="White" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
