<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:OpcBridge.Hmi.ViewModels.Widgets"
             x:Class="OpcBridge.Hmi.Controls.Widgets.QualityLampWidgetView"
             x:DataType="widgets:QualityLampWidgetViewModel">
  <Border Background="{DynamicResource WidgetSurfaceBrush}"
          CornerRadius="4"
          Padding="8,4"
          PointerPressed="OnPointerPressed">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <!-- Default is the no-data colour; the code-behind swaps it as quality arrives. -->
      <Ellipse Width="18" Height="18" VerticalAlignment="Center"
               Fill="{DynamicResource QualityUncertainBrush}" />
      <StackPanel>
        <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.8" Foreground="{DynamicResource MutedFgBrush}" />
        <TextBlock Text="{Binding QualityText}" Foreground="{DynamicResource TextBrush}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
