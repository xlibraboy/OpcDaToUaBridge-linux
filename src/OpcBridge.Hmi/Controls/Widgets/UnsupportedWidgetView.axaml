<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:OpcBridge.Hmi.ViewModels.Widgets"
             x:Class="OpcBridge.Hmi.Controls.Widgets.UnsupportedWidgetView"
             x:DataType="widgets:WidgetViewModelBase">
  <Border Background="{DynamicResource BadBgBrush}" CornerRadius="4" Padding="6">
    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BadFgBrush}" TextWrapping="Wrap" />
  </Border>
</UserControl>
