<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpcBridge.Hmi.ViewModels"
             x:Class="OpcBridge.Hmi.Views.TrendGroupsPage"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="380,*" Margin="12">

    <!-- ======== Saved groups ======== -->
    <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="sectionLabel" Text="TREND GROUPS" />
        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Named tag groups. Opening one restores the colours, Y ranges and hidden pens it was closed with." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Classes="primary" Content="New group…" Command="{Binding NewTrendGroupCommand}" MinWidth="110" />
          <Button Classes="danger" Content="Delete" Command="{Binding DeleteTrendGroupCommand}" MinWidth="80" />
        </StackPanel>

        <Panel>
          <ListBox ItemsSource="{Binding TrendGroups}"
                   SelectedItem="{Binding SelectedTrendGroup}"
                   AutomationProperties.Name="Trend groups">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrendGroupItemViewModel">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="hint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="hint" Margin="8" TextWrapping="Wrap"
                     IsVisible="{Binding !HasTrendGroups}"
                     Text="No trend groups yet. Click New group… to pick tags and give the group a name." />
        </Panel>
      </DockPanel>
    </Border>

    <!-- ======== Tags of the selected group ========
         The pane is always drawn, so the page reads as two panels at every width instead
         of leaving an empty field next to the list when nothing is selected. -->
    <Border Grid.Column="1" Classes="card">
      <Grid>
        <DockPanel IsVisible="{Binding HasSelectedTrendGroup}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="sectionLabel" Text="GROUP NAME"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1"
                     AutomationProperties.Name="Group name"
                     Watermark="Group name"
                     Text="{Binding SelectedTrendGroup.Name}"
                     LostFocus="OnGroupNameLostFocus"
                     KeyDown="OnGroupNameKeyDown" />
          </Grid>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,2*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE" />
            <TextBlock Grid.Column="1" Classes="listHeader" Text="SOURCE" />
            <TextBlock Grid.Column="2" Classes="listHeader" Text="TAG" />
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="primary" Content="Open chart" Command="{Binding OpenTrendGroupChartCommand}" MinWidth="110" />
            <Button Content="Add tags…" Command="{Binding AddTagsToTrendGroupCommand}" MinWidth="100" />
            <Button Content="Remove tag" Command="{Binding RemoveSelectedGroupTagCommand}" MinWidth="100" />
          </StackPanel>

          <ListBox ItemsSource="{Binding SelectedTrendGroup.Tags}"
                   SelectedItem="{Binding SelectedGroupTag}"
                   AutomationProperties.Name="Tags in this group">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TagListRow">
                <Grid ColumnDefinitions="*,*,2*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding BridgeId}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SourceName}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Classes="hint" Margin="10,0,0,0"
                             IsVisible="{Binding HasMarker}"
                             Text="{Binding Marker}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="400"
                    IsVisible="{Binding !HasSelectedTrendGroup}">
          <TextBlock Classes="sectionLabel" HorizontalAlignment="Center" Margin="0"
                     Text="NO GROUP SELECTED" />
          <TextBlock Classes="hint" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Pick a group in the list to edit its tags, rename it, or open its chart. A group remembers the colours, Y ranges and hidden pens it was closed with." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
