<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpcBridge.Hmi.Views.TrendTimeRangeWindow"
        Title="Time range"
        FontSize="11"
        Width="430"
        SizeToContent="Height"
        MinWidth="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">

    <!-- Clock indicator: pickers use the app's local zone; the trend stores UTC -->
    <TextBlock x:Name="ClockHint" Classes="hint" Text="" />

    <!-- From -->
    <TextBlock FontWeight="SemiBold" Text="From" />
    <DatePicker x:Name="FromDate" HorizontalAlignment="Stretch" />
    <TimePicker x:Name="FromTime" HorizontalAlignment="Stretch" />

    <Separator Margin="0,2" />

    <!-- To -->
    <TextBlock FontWeight="SemiBold" Text="To" />
    <DatePicker x:Name="ToDate" HorizontalAlignment="Stretch" />
    <TimePicker x:Name="ToTime" HorizontalAlignment="Stretch" />

    <!-- Quick presets: relative to now -->
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
      <Button Content="Last 15m" Click="OnPresetClick" Tag="15m" MinWidth="74" />
      <Button Content="Last 1h" Click="OnPresetClick" Tag="1h" MinWidth="74" />
      <Button Content="Last 8h" Click="OnPresetClick" Tag="8h" MinWidth="74" />
      <Button Content="Last 24h" Click="OnPresetClick" Tag="24h" MinWidth="74" />
    </StackPanel>

    <!-- Live span preview + validation -->
    <TextBlock x:Name="PreviewText" Classes="hint" Text="" />
    <TextBlock x:Name="ErrorText" Classes="hint" Foreground="IndianRed" Text="" />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <Button Classes="primary" Content="Apply" Click="OnApplyClick" IsDefault="True" MinWidth="90" />
      <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
