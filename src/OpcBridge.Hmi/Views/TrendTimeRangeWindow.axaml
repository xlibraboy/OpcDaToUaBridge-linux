<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpcBridge.Hmi.Views.TrendTimeRangeWindow"
        Title="Custom time range"
        Width="380"
        Height="260"
        MinWidth="340"
        MinHeight="240"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14" Spacing="12">
    <StackPanel Spacing="4">
      <TextBlock FontWeight="SemiBold" Text="From" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <DatePicker x:Name="FromDate" Width="200" />
        <TimePicker x:Name="FromTime" Width="120" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock FontWeight="SemiBold" Text="To" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <DatePicker x:Name="ToDate" Width="200" />
        <TimePicker x:Name="ToTime" Width="120" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Classes="hint" Foreground="IndianRed" Text="" />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
      <Button Classes="primary" Content="Apply" Click="OnApplyClick" MinWidth="90" />
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>