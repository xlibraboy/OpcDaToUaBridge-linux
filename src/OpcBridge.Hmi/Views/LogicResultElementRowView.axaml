<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicResultElementRowView"
             x:DataType="logic:LogicResultElementRowViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- The nesting rail: one guide per enclosing level, drawn beside the row card so a deep
         network reads as a tree. -->
    <ItemsControl Grid.Column="0" ItemsSource="{Binding Guides}" Margin="8,0,0,0"
                  VerticalAlignment="Stretch">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter">
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="18" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource GridLineBrush}"
                  VerticalAlignment="Stretch" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- One evaluated element: the reading in large mono digits, with the sentence that explains
         it and the small print (should line, progress, tag, next step) under it. -->
    <Border Grid.Column="1" Margin="0,0,0,6" Padding="10,7" CornerRadius="4"
            Background="{DynamicResource WellBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" Classes="mono" FontSize="13" FontWeight="Bold"
                     Text="{Binding Mark}" VerticalAlignment="Center"
                     Classes.stateOk="{Binding IsOk}"
                     Classes.stateBad="{Binding IsBad}"
                     Classes.stateWarn="{Binding IsWarn}" />
          <TextBlock Grid.Column="1" Classes="mono" FontSize="11" MinWidth="52" Margin="8,0,0,0"
                     Foreground="{DynamicResource MutedFgBrush}" Text="{Binding KindLabel}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock FontSize="13" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Classes="hint warn" Text="warn only" IsVisible="{Binding WarnOnly}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="3" Classes="mono" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0"
                     Text="{Binding Actual}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Actual}"
                     Classes.stateOk="{Binding IsOk}"
                     Classes.stateBad="{Binding IsBad}"
                     Classes.stateWarn="{Binding IsWarn}" />
          <TextBlock Grid.Column="4" Classes="mono" FontSize="11" Margin="8,0,0,2"
                     Foreground="{DynamicResource MutedFgBrush}" Text="{Binding ValueText}"
                     VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ValueText}" />
        </Grid>
        <TextBlock Classes="mono" FontSize="11" Text="{Binding ShouldLine}" IsVisible="{Binding HasShould}"
                   Classes.stateOk="{Binding IsShouldOk}"
                   Classes.stateBad="{Binding IsShouldBad}" />
        <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource WarnFgBrush}"
                   Text="{Binding Progress}" IsVisible="{Binding HasProgress}" />
        <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource MutedFgBrush}"
                   Text="{Binding TagLabel}" IsVisible="{Binding HasTag}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TagLabel}" />
        <TextBlock Classes="hint warn" FontSize="12" Text="{Binding NextStepText}"
                   TextWrapping="Wrap" IsVisible="{Binding HasNextStep}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
