<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.FaceplateWindow"
        x:DataType="vm:FaceplateViewModel"
        Title="{Binding Title}"
        Width="420"
        Height="520"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Border Classes="card">
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Writeable}">
          <TextBlock VerticalAlignment="Center" Text="Write:" />
          <TextBox Width="180" Text="{Binding WriteValue}" />
          <Button Classes="primary" Content="Write" Command="{Binding WriteCommand}" MinWidth="80" />
        </StackPanel>
      </Border>
      <Button Content="Open trend" Command="{Binding OpenTrendCommand}" HorizontalAlignment="Left" MinWidth="120" />
      <TextBlock Classes="hint" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DisplayName}" />
        <TextBlock Classes="hint" Text="{Binding BridgeId, StringFormat=Bridge: {0}}" />
        <TextBlock Classes="hint" Text="{Binding SourceId, StringFormat=Source: {0}}" />
        <TextBlock Classes="hint" Text="{Binding DaItemId, StringFormat=Item: {0}}" />
        <TextBlock Classes="hint" Text="{Binding DataType, StringFormat=Type: {0}}" />

        <Border Classes="cardDark" Padding="16,12" Margin="0,6,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="cardTitle" Text="CURRENT VALUE" />
            <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding ValueText}" />
            <TextBlock Classes="hint" Text="{Binding QualityText, StringFormat=Quality: {0}}" />
            <TextBlock Classes="hint" Text="{Binding TimestampText, StringFormat=Timestamp: {0}}" />
          </StackPanel>
        </Border>

        <TextBlock Classes="sectionLabel" Margin="0,6,0,0" Text="HISTORY (1H)" />
        <Border Classes="cardDark" Padding="8">
          <controls:SparklineControl Height="80" Points="{Binding TrendValues}" />
        </Border>
        <TextBlock Classes="hint" Text="{Binding TrendStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
