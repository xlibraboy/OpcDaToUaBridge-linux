<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.TrendWindow"
        x:DataType="vm:TrendViewModel"
        Title="{Binding Title}"
        Width="640"
        Height="420"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              MinWidth="80" />
      <Button DockPanel.Dock="Right"
              Content="Reset zoom"
              Command="{Binding ResetZoomCommand}"
              IsVisible="{Binding IsZoomed}"
              MinWidth="90"
              Margin="0,0,8,0" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <RadioButton Classes="seg" GroupName="range" Content="1h"
                     IsChecked="{Binding IsRange1h, Mode=OneWay}"
                     Command="{Binding SetRangeCommand}" CommandParameter="1" />
        <RadioButton Classes="seg" GroupName="range" Content="8h"
                     IsChecked="{Binding IsRange8h, Mode=OneWay}"
                     Command="{Binding SetRangeCommand}" CommandParameter="8" />
        <RadioButton Classes="seg" GroupName="range" Content="24h"
                     IsChecked="{Binding IsRange24h, Mode=OneWay}"
                     Command="{Binding SetRangeCommand}" CommandParameter="24" />
      </StackPanel>
      <CheckBox VerticalAlignment="Center"
                Margin="16,0,0,0"
                Content="Auto range"
                IsChecked="{Binding AutoRange}"
                IsEnabled="{Binding HasFixedRange}"
                ToolTip.Tip="Fit the Y axis to the data. Turn off to pin the axis to the tag's data-type range (not available for floating-point types)." />
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="hint" Text="{Binding BridgeId, StringFormat=Bridge: {0}}" />
        <TextBlock Classes="hint" Text="{Binding DaItemId, StringFormat=Item: {0}}" />
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Classes="hint"
               Text="{Binding StatusMessage}"
               TextWrapping="Wrap" />
    <Border Classes="cardDark" Padding="8">
      <controls:TrendChartControl x:Name="TrendChart"
                                  EnableRangeZoom="True"
                                  Samples="{Binding Samples}"
                                  FromUtc="{Binding FromUtc}"
                                  ToUtc="{Binding ToUtc}"
                                  YMin="{Binding AxisMin}"
                                  YMax="{Binding AxisMax}"
                                  YStep="{Binding AxisStep}"
                                  Unit="{Binding Unit}"
                                  TrendStyle="{Binding TrendStyle}" />
    </Border>
  </DockPanel>
</Window>
