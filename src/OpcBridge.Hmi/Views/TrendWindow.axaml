<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.TrendWindow"
        x:DataType="vm:TrendWindowViewModelBase"
        Title="{Binding Title}"
        FontSize="11"
        Width="900"
        Height="680"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <!-- Row 1: range, auto-range, live controls, pan, zoom reset, export, refresh -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right"
              Content="Export CSV"
              Click="OnExportClick"
              MinWidth="90" />
      <Button DockPanel.Dock="Right"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsLoading}"
              ToolTip.Tip="Reload history for the current window"
              MinWidth="80" />
      <Button DockPanel.Dock="Right"
              Content="Reset zoom"
              Command="{Binding ResetZoomCommand}"
              IsVisible="{Binding IsZoomed}"
              MinWidth="90"
              Margin="0,0,8,0" />
      <Button DockPanel.Dock="Right"
              Content="▶"
              ToolTip.Tip="Pan forward"
              Command="{Binding PanForwardCommand}"
              MinWidth="30"
              Margin="0,0,8,0" />
      <Button DockPanel.Dock="Right"
              Content="◀"
              ToolTip.Tip="Pan back"
              Command="{Binding PanBackCommand}"
              MinWidth="30"
              Margin="0,0,8,0" />
      <Button DockPanel.Dock="Right"
              Content="{Binding PauseLabel}"
              Command="{Binding TogglePauseCommand}"
              MinWidth="70"
              Margin="0,0,8,0" />
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="Period" />
        <ComboBox MinWidth="84"
                  ItemsSource="{Binding RangeChoices}"
                  SelectedItem="{Binding RangeSelection, Mode=TwoWay}"
                  ToolTip.Tip="Time window loaded into the trend; shows Custom while zoomed" />
        <TextBlock Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" Text="Interval" />
        <ComboBox MinWidth="84"
                  ItemsSource="{Binding IntervalChoices}"
                  SelectedItem="{Binding IntervalLabel, Mode=TwoWay}"
                  ToolTip.Tip="History sampling interval — Auto keeps up to 1000 points per pen; a fixed interval keeps one point per step (capped at 2000)" />
      </StackPanel>
      <CheckBox VerticalAlignment="Center"
                Margin="16,0,0,0"
                Content="Auto range"
                IsChecked="{Binding AutoRange}"
                IsEnabled="{Binding HasFixedRange}"
                ToolTip.Tip="Fit the pen axes to the data. Turn off to pin the axis to the tag's data-type range (not available for floating-point types)." />
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                  IsVisible="{Binding HasBridgeHint}">
        <TextBlock Classes="hint" Text="{Binding BridgeId, StringFormat=Bridge: {0}}" />
        <TextBlock Classes="hint" Text="{Binding DaItemId, StringFormat=Item: {0}}" />
      </StackPanel>
    </DockPanel>

    <!-- Row 2: custom range, alarm limits (single), Y-axis mode (group) -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Time range…" Click="OnCustomRangeClick" MinWidth="100"
                ToolTip.Tip="Pick an exact from/to window (defaults to now)" />
        <Button Content="Clear ranges"
                Command="{Binding ClearCustomRangesCommand}"
                IsVisible="{Binding HasCustomRanges}"
                ToolTip.Tip="Reset every pen's Y axis back to auto-fit"
                MinWidth="95" />
        <Button Content="Clear pin"
                Command="{Binding ClearPinCommand}"
                IsVisible="{Binding HasPin}"
                MinWidth="80" />
        <StackPanel Orientation="Horizontal" Spacing="6"
                    IsVisible="{Binding SupportsAlarmLimits}">
          <TextBlock Classes="hint" VerticalAlignment="Center" Text="Alarm" />
          <TextBox Width="72"
                   VerticalAlignment="Center"
                   Watermark="HI"
                   Text="{Binding AlarmHighText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Width="72"
                   VerticalAlignment="Center"
                   Watermark="LO"
                   Text="{Binding AlarmLowText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"
                    IsVisible="{Binding SupportsPercentAxis}">
          <RadioButton Classes="seg" GroupName="axis" Content="Per-pen scale"
                       IsChecked="{Binding IsSharedAxis, Mode=OneWay}"
                       Command="{Binding SetAxisModeCommand}" CommandParameter="Shared" />
          <RadioButton Classes="seg" GroupName="axis" Content="0–100 %"
                       IsChecked="{Binding IsPercentAxis, Mode=OneWay}"
                       Command="{Binding SetAxisModeCommand}" CommandParameter="Percent" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"
                    IsVisible="{Binding SupportsLayoutToggle}">
          <RadioButton Classes="seg" GroupName="layout" Content="Mixed"
                       IsChecked="{Binding IsMixedLayout, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Mixed"
                       ToolTip.Tip="Overlay all pens on one plot, with each pen's min–max scale in the legend" />
          <RadioButton Classes="seg" GroupName="layout" Content="Strips"
                       IsChecked="{Binding !IsMixedLayout, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Stacked"
                       ToolTip.Tip="One strip per pen, each with its own axis" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Classes="hint"
               Text="{Binding StatusMessage}"
               TextWrapping="Wrap" />

    <!-- Chart fills the remaining height; the scrollable pen table docks below -->
    <DockPanel>
      <!-- Pen configuration table: visibility, color, name, description, live + windowed stats -->
      <Border DockPanel.Dock="Bottom" Classes="cardDark" Padding="8" Margin="0,8,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="200">
          <Grid RowDefinitions="Auto,*" Margin="0">
            <!-- Header row: bottom rule + column separators (definitions mirror the data rows) -->
            <Border Grid.Row="0" BorderBrush="#2EFFFFFF" BorderThickness="0,0,0,1"
                    ToolTip.Tip="Click an empty area to clear pen emphasis"
                    PointerPressed="OnPenTableBackgroundClick">
              <Grid ColumnDefinitions="22,22,1.3*,1,1.1*,1,0.5*,1,0.9*,1,0.9*,1,0.8*,1,0.8*,1,0.8*" MinHeight="24">
                <TextBlock Grid.Column="2" Classes="listHeader" Text="Name" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="listHeader" Text="Description" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="listHeader" Text="Unit" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Classes="listHeader" Text="Range (min–max)" VerticalAlignment="Center"
                           ToolTip.Tip="Actual data range shown as watermarks; type values to set a custom Y-axis scale (leave empty to auto-fit)" />
                <TextBlock Grid.Column="10" Classes="listHeader" Text="Value" VerticalAlignment="Center" />
                <TextBlock Grid.Column="12" Classes="listHeader" Text="Minimum" VerticalAlignment="Center" />
                <TextBlock Grid.Column="14" Classes="listHeader" Text="Maximum" VerticalAlignment="Center" />
                <TextBlock Grid.Column="16" Classes="listHeader" Text="Average" VerticalAlignment="Center" />
                <Rectangle Grid.Column="3" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="5" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="7" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="9" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="11" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="13" Width="1" Fill="#24FFFFFF" />
                <Rectangle Grid.Column="15" Width="1" Fill="#24FFFFFF" />
              </Grid>
            </Border>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Pens}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrendPenViewModel">
                  <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                          Background="{Binding RowBackground, Converter={x:Static vm:HexToBrushConverter.Instance}}"
                          Tag="{Binding Name}"
                          Cursor="Hand"
                          ToolTip.Tip="Click to emphasize this pen (thick line); click again to clear · Ctrl+click toggles several pens"
                          PointerPressed="OnPenRowClick">
                    <Grid ColumnDefinitions="22,22,1.3*,1,1.1*,1,0.5*,1,0.9*,1,0.9*,1,0.8*,1,0.8*,1,0.8*" MinHeight="24">
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsVisible}"
                                Height="16" Padding="0"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Border Grid.Column="1"
                              Width="18" Height="10"
                              CornerRadius="2"
                              Tag="{Binding Name}"
                              Background="{Binding Color, Converter={x:Static vm:HexToBrushConverter.Instance}}"
                              VerticalAlignment="Center"
                              Cursor="Hand"
                              ToolTip.Tip="Click to cycle color"
                              PointerPressed="OnPenSwatchClick" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                 Classes="hint" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding Unit}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <Grid Grid.Column="8" ColumnDefinitions="*,10,*" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Height="20" Padding="4,1" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding !IsBoolean}"
                                 Text="{Binding RangeMinText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{Binding RangeMinWatermark}"
                                 ToolTip.Tip="Custom Y-axis minimum (empty = auto); fixed for on/off tags" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Height="20" Padding="4,1" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding !IsBoolean}"
                                 Text="{Binding RangeMaxText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{Binding RangeMaxWatermark}"
                                 ToolTip.Tip="Custom Y-axis maximum (empty = auto); fixed for on/off tags" />
                      </Grid>
                      <TextBlock Grid.Column="10" Text="{Binding ValueText}" Classes="valueText"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="12" Text="{Binding MinimumText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="14" Text="{Binding MaximumText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="16" Text="{Binding AverageText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <Rectangle Grid.Column="3" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="5" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="7" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="9" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="11" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="13" Width="1" Fill="#24FFFFFF" />
                      <Rectangle Grid.Column="15" Width="1" Fill="#24FFFFFF" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </Border>

      <Border Classes="cardDark" Padding="8">
        <controls:TrendChartControl x:Name="TrendChart"
                                    EnableRangeZoom="True"
                                    LayoutMode="{Binding LayoutMode}"
                                    Series="{Binding Series}"
                                    FromUtc="{Binding FromUtc}"
                                    ToUtc="{Binding ToUtc}"
                                    YAxisMode="{Binding YAxisMode}"
                                    PinnedAtUtc="{Binding PinnedAtUtc}"
                                    AlarmHigh="{Binding AlarmHigh}"
                                    AlarmLow="{Binding AlarmLow}" />
      </Border>
    </DockPanel>
  </DockPanel>
</Window>
