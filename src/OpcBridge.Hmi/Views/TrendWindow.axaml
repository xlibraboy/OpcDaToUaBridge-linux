<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.TrendWindow"
        x:DataType="vm:TrendWindowViewModelBase"
        Title="{Binding Title}"
        FontSize="11"
        Width="900"
        Height="680"
        MinWidth="640"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Compact high-contrast pen checkbox: the Fluent template turns into a dark blob
         below ~16px on the dark theme, so the pen table draws its own 15px square with
         a crisp border that fills blue when checked (no tick glyph). -->
    <Style Selector="CheckBox.PenCheck">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Box"
                  Width="15" Height="15"
                  CornerRadius="3"
                  BorderThickness="1.3"
                  BorderBrush="{DynamicResource MutedFgBrush}"
                  Background="{DynamicResource GridLineBrush}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.PenCheck:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource AccentMarkerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="CheckBox.PenCheck:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
    </Style>
    <!-- The emphasized pen row is tinted with the accent family rather than a stray blue. -->
    <Style Selector="Border.penRow.selected">
      <Setter Property="Background" Value="{DynamicResource PenEmphasisBrush}" />
    </Style>
    <!-- Flat grip button on the splitter bar; hover/focus lights up a wide pill. -->
    <Style Selector="Button.SplitterGrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="GripPill" Width="44" Height="10" CornerRadius="5" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <StackPanel Orientation="Vertical" Spacing="1.5">
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Spacing="1.5">
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
                <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.SplitterGrip:pointerover /template/ Border#GripPill">
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="Button.SplitterGrip:pointerover /template/ Ellipse">
      <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.SplitterGrip:focus-visible /template/ Border#GripPill">
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentValueBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- The whole bar highlights when the pointer is anywhere over the splitter. -->
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource FrameBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <!-- Command band. Controls are grouped by what they act on, and each group wraps as a
         whole unit, so narrowing the window reflows the band instead of stacking controls
         on top of each other. The two data actions keep a stable corner on the right. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right"
              Content="Export CSV"
              Click="OnExportClick"
              MinWidth="90"
              Margin="16,0,0,0"
              VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsLoading}"
              ToolTip.Tip="Reload history for the current window"
              MinWidth="80"
              VerticalAlignment="Center" />
      <WrapPanel Orientation="Horizontal">

        <!-- Time window: the history the trend is showing -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,16,3">
          <TextBlock Classes="hint" VerticalAlignment="Center" Text="Period" />
          <ComboBox MinWidth="84"
                    ItemsSource="{Binding RangeChoices}"
                    SelectedItem="{Binding RangeSelection, Mode=TwoWay}"
                    ToolTip.Tip="Time window loaded into the trend; shows Custom while zoomed" />
          <TextBlock Classes="hint" VerticalAlignment="Center" Margin="6,0,0,0" Text="Interval" />
          <ComboBox MinWidth="84"
                    ItemsSource="{Binding IntervalChoices}"
                    SelectedItem="{Binding IntervalLabel, Mode=TwoWay}"
                    ToolTip.Tip="History sampling interval — Auto keeps up to 1000 points per pen; a fixed interval keeps one point per step (capped at 2000)" />
          <Button Content="Time range…" Click="OnCustomRangeClick" MinWidth="100"
                  ToolTip.Tip="Pick an exact from/to window (defaults to now)" />
        </StackPanel>

        <!-- Moving through time: follow now, step the window, or drop the zoom and pins -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,16,3">
          <Button Content="{Binding PauseLabel}"
                  Command="{Binding TogglePauseCommand}"
                  MinWidth="70" />
          <Button Content="◀"
                  AutomationProperties.Name="Pan back"
                  ToolTip.Tip="Pan back"
                  Command="{Binding PanBackCommand}"
                  MinWidth="36"
                  MinHeight="28" />
          <Button Content="▶"
                  AutomationProperties.Name="Pan forward"
                  ToolTip.Tip="Pan forward"
                  Command="{Binding PanForwardCommand}"
                  MinWidth="36"
                  MinHeight="28" />
          <Button Content="Reset zoom"
                  Command="{Binding ResetZoomCommand}"
                  IsVisible="{Binding IsZoomed}"
                  MinWidth="90" />
          <Button Content="Clear pin"
                  Command="{Binding ClearPinCommand}"
                  IsVisible="{Binding HasPin}"
                  MinWidth="80" />
        </StackPanel>

        <!-- Y scale: fit or pin the axis, and the group-trend normalisation -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,16,3">
          <CheckBox VerticalAlignment="Center"
                    Content="Auto range"
                    IsChecked="{Binding AutoRange}"
                    IsEnabled="{Binding HasFixedRange}"
                    ToolTip.Tip="Fit the pen axes to the data. Turn off to pin the axis to the tag's data-type range (not available for floating-point types)." />
          <StackPanel Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center"
                      IsVisible="{Binding SupportsPercentAxis}">
            <RadioButton Classes="seg" GroupName="axis" Content="Per-pen scale"
                         IsChecked="{Binding IsSharedAxis, Mode=OneWay}"
                         Command="{Binding SetAxisModeCommand}" CommandParameter="Shared" />
            <RadioButton Classes="seg" GroupName="axis" Content="0–100 %"
                         IsChecked="{Binding IsPercentAxis, Mode=OneWay}"
                         Command="{Binding SetAxisModeCommand}" CommandParameter="Percent" />
          </StackPanel>
          <Button Content="Clear ranges"
                  Command="{Binding ClearCustomRangesCommand}"
                  IsVisible="{Binding HasCustomRanges}"
                  ToolTip.Tip="Reset every pen's Y axis back to auto-fit"
                  MinWidth="95" />
        </StackPanel>

        <!-- Alarm limits on the Y axis (single-tag trends) -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,16,3"
                    IsVisible="{Binding SupportsAlarmLimits}">
          <TextBlock Classes="hint" VerticalAlignment="Center" Text="Alarm" />
          <TextBox Width="72"
                   VerticalAlignment="Center"
                   Watermark="HI"
                   AutomationProperties.Name="High alarm limit"
                   Text="{Binding AlarmHighText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Width="72"
                   VerticalAlignment="Center"
                   Watermark="LO"
                   AutomationProperties.Name="Low alarm limit"
                   Text="{Binding AlarmLowText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Pen arrangement (group trends) -->
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,3,0,3"
                    IsVisible="{Binding SupportsLayoutToggle}">
          <RadioButton Classes="seg" GroupName="layout" Content="Mixed"
                       IsChecked="{Binding IsMixedLayout, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Mixed"
                       ToolTip.Tip="Overlay all pens on one plot, with each pen's min–max scale in the legend" />
          <RadioButton Classes="seg" GroupName="layout" Content="Strips"
                       IsChecked="{Binding !IsMixedLayout, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Stacked"
                       ToolTip.Tip="One strip per pen, each with its own axis" />
        </StackPanel>
      </WrapPanel>
    </DockPanel>

    <!-- Status line: what the trend is doing, and which tag it is reading -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Classes="hint"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding StatusMessage}"
                 Text="{Binding StatusMessage}" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal" Spacing="12"
                  Margin="12,0,0,0"
                  IsVisible="{Binding HasBridgeHint}">
        <TextBlock Classes="hint" Text="{Binding BridgeId, StringFormat=Bridge: {0}}" />
        <TextBlock Classes="hint" Text="{Binding DaItemId, StringFormat=Item: {0}}" />
      </StackPanel>
    </Grid>

    <!-- Chart and pen table share the window height; drag the splitter between them -->
    <Grid>
      <Grid.RowDefinitions>
        <!-- The plot keeps a floor of its own so the axes never collapse into the toolbar -->
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition Height="12" />
        <RowDefinition Height="232" />
      </Grid.RowDefinitions>
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource CardBorderBrush}" CornerRadius="2"
                    ToolTip.Tip="Drag to resize · double-click the bar (or click the grip) to collapse/expand the pen table"
                    DoubleTapped="OnSplitterToggle" />
      <!-- Grip button: a real click target (GridSplitter swallows DoubleTapped while dragging).
           Clicking toggles the table; drag still works on the bar around it. -->
      <Button Grid.Row="1" Classes="SplitterGrip"
              MinWidth="48" MinHeight="12"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.Name="Collapse or expand the pen table"
              Click="OnSplitterToggle"
              ToolTip.Tip="Collapse/expand pen table">
        <StackPanel Orientation="Horizontal" Spacing="2" IsHitTestVisible="False">
          <StackPanel Orientation="Vertical" Spacing="1.5">
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
          </StackPanel>
          <StackPanel Orientation="Vertical" Spacing="1.5">
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
            <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource MutedFgBrush}" />
          </StackPanel>
        </StackPanel>
      </Button>

      <!-- Pen configuration table: visibility, color, name, description, live + windowed stats.
           The table keeps a legible width and scrolls sideways rather than crushing its
           columns together when the window is narrower than the table needs. -->
      <Border Grid.Row="2" Classes="cardDark" Padding="8" Margin="0,4,0,0"
              IsVisible="{Binding !IsPenTableCollapsed}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Grid RowDefinitions="Auto,*" Margin="0">
            <!-- Header row: bottom rule + column separators (definitions mirror the data rows) -->
            <Border Grid.Row="0" Classes="focusRing"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                    Focusable="True"
                    AutomationProperties.Name="Clear pen emphasis"
                    AutomationProperties.HelpText="Press Enter or Space to clear the emphasis on every trace."
                    ToolTip.Tip="Click an empty area, or press Enter here, to clear pen emphasis"
                    PointerPressed="OnPenTableBackgroundClick"
                    KeyDown="OnClearEmphasisKeyDown">
              <Grid ColumnDefinitions="26,26,1.3*,1,1.1*,1,0.5*,1,0.9*,1,0.9*,1,0.8*,1,0.8*,1,0.8*" MinHeight="24" MinWidth="820">
                <TextBlock Grid.Column="2" Classes="listHeader" Text="Name" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="listHeader" Text="Description" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="listHeader" Text="Unit" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Classes="listHeader" Text="Range (min–max)" VerticalAlignment="Center"
                           ToolTip.Tip="Actual data range shown as watermarks; type values to set a custom Y-axis scale (leave empty to auto-fit)" />
                <TextBlock Grid.Column="10" Classes="listHeader" Text="Value" VerticalAlignment="Center" />
                <TextBlock Grid.Column="12" Classes="listHeader" Text="Minimum" VerticalAlignment="Center" />
                <TextBlock Grid.Column="14" Classes="listHeader" Text="Maximum" VerticalAlignment="Center" />
                <TextBlock Grid.Column="16" Classes="listHeader" Text="Average" VerticalAlignment="Center" />
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="7" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="9" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="11" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="13" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                <Rectangle Grid.Column="15" Width="1" Fill="{DynamicResource CardBorderBrush}" />
              </Grid>
            </Border>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Pens}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrendPenViewModel">
                  <Border Classes="focusRing penRow"
                          Classes.selected="{Binding IsSelected}"
                          BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"
                          Tag="{Binding Name}"
                          Focusable="True"
                          Cursor="Hand"
                          AutomationProperties.Name="{Binding Name, StringFormat='Emphasize pen {0}'}"
                          AutomationProperties.HelpText="Enter or Space emphasizes this trace. Ctrl+Enter toggles it alongside the others."
                          ToolTip.Tip="Click to emphasize this pen (thick line); click again to clear · Ctrl+click toggles several pens"
                          PointerPressed="OnPenRowClick"
                          KeyDown="OnPenRowKeyDown">
                    <Grid ColumnDefinitions="26,26,1.3*,1,1.1*,1,0.5*,1,0.9*,1,0.9*,1,0.8*,1,0.8*,1,0.8*" MinHeight="24" MinWidth="820">
                      <CheckBox Grid.Column="0"
                                Classes="PenCheck"
                                IsChecked="{Binding IsVisible}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Button Grid.Column="1"
                              Classes="flat"
                              Padding="0"
                              MinWidth="24" MinHeight="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Tag="{Binding Name}"
                              Cursor="Hand"
                              AutomationProperties.Name="{Binding Name, StringFormat='Cycle the trace colour of {0}'}"
                              ToolTip.Tip="Click to cycle color"
                              Click="OnPenSwatchClick">
                        <Border Width="18" Height="10"
                                CornerRadius="2"
                                Background="{Binding Color, Converter={x:Static vm:HexToBrushConverter.Instance}}" />
                      </Button>
                      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                 Classes="hint" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding Unit}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <Grid Grid.Column="8" ColumnDefinitions="*,10,*" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Height="18" MinHeight="18" Padding="4,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding !IsBoolean}"
                                 Text="{Binding RangeMinText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{Binding RangeMinWatermark}"
                                 ToolTip.Tip="Custom Y-axis minimum (empty = auto); fixed for on/off tags" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Height="18" MinHeight="18" Padding="4,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding !IsBoolean}"
                                 Text="{Binding RangeMaxText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{Binding RangeMaxWatermark}"
                                 ToolTip.Tip="Custom Y-axis maximum (empty = auto); fixed for on/off tags" />
                      </Grid>
                      <TextBlock Grid.Column="10" Text="{Binding ValueText}" Classes="valueText"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="12" Text="{Binding MinimumText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="14" Text="{Binding MaximumText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="16" Text="{Binding AverageText}" Classes="hint"
                                 VerticalAlignment="Center" />
                      <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="7" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="9" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="11" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="13" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                      <Rectangle Grid.Column="15" Width="1" Fill="{DynamicResource CardBorderBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="0" Classes="cardDark" Padding="8">
        <controls:TrendChartControl x:Name="TrendChart"
                                    EnableRangeZoom="True"
                                    LayoutMode="{Binding LayoutMode}"
                                    Series="{Binding Series}"
                                    FromUtc="{Binding FromUtc}"
                                    ToUtc="{Binding ToUtc}"
                                    YAxisMode="{Binding YAxisMode}"
                                    Pins="{Binding Pins}"
                                    AlarmHigh="{Binding AlarmHigh}"
                                    AlarmLow="{Binding AlarmLow}"
                                    ShowNamesInHover="{Binding IsPenTableCollapsed}"
                                    AutomationProperties.Name="Trend chart"
                                    AutomationProperties.HelpText="Arrow keys move the time cursor, Shift with an arrow moves further, Home and End jump to the window edges, Enter pins or unpins a time, Delete removes the pin under the cursor, Escape hides the cursor." />
      </Border>
    </Grid>
  </DockPanel>
</Window>
