<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicConditionRowView"
             x:DataType="logic:LogicConditionRowViewModel">
  <Grid ColumnDefinitions="260,130,190,175,80,110,70,110,200,80,32" Margin="0,2">
    <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Text}"
             Watermark="Operator sentence" AutomationProperties.Name="Condition sentence" />
    <ComboBox Grid.Column="1" Margin="0,0,4,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
              AutomationProperties.Name="Condition source"
              ToolTip.Tip="{Binding SelectedSource.Label}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicSourceOption">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <ComboBox Grid.Column="2" Margin="0,0,4,0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTag}"
              AutomationProperties.Name="Condition tag"
              ToolTip.Tip="{Binding SelectedTag.Detail}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicTagOption">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <ComboBox Grid.Column="3" Margin="0,0,4,0" ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op}"
              AutomationProperties.Name="Condition operator">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicSelectOption">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox Grid.Column="4" Margin="0,0,4,0" Text="{Binding ValueText}" Watermark="value"
             IsVisible="{Binding NeedsValue}" AutomationProperties.Name="Comparison value" />
    <TextBox Grid.Column="5" Margin="0,0,4,0" Text="{Binding Group}" Watermark="OR group"
             AutomationProperties.Name="OR group"
             ToolTip.Tip="Conditions sharing a group are any-of; everything else is AND." />
    <TextBox Grid.Column="6" Margin="0,0,4,0" Text="{Binding HoldSeconds}" Watermark="hold s"
             AutomationProperties.Name="Hold seconds"
             ToolTip.Tip="TON on-delay: the contact counts only after holding this long." />
    <ComboBox Grid.Column="7" Margin="0,0,4,0" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}"
              AutomationProperties.Name="Condition severity">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicSelectOption">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox Grid.Column="8" Margin="0,0,4,0" Text="{Binding NextStepText}" Watermark="What to do next"
             AutomationProperties.Name="Next step text" />
    <TextBlock Grid.Column="9" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding LiveText}"
               Classes.stateOk="{Binding IsLiveOk}"
               Classes.stateBad="{Binding IsLiveBad}"
               Classes.stateWarn="{Binding IsLiveWarn}"
               AutomationProperties.LiveSetting="Polite"
               ToolTip.Tip="Live state: 1 / 0 / no data for a bit, the value for a comparison." />
    <Button Grid.Column="10" Classes="tool" Content="✕" Command="{Binding RemoveCommand}"
            AutomationProperties.Name="Remove condition" />
  </Grid>
</UserControl>
