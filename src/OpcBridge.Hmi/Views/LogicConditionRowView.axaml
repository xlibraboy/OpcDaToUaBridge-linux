<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicConditionRowView"
             x:DataType="logic:LogicConditionRowViewModel">
  <!-- One condition, as its own row: the fields wrap, each carries its label, and the live
       reading stays pinned at the right edge. -->
  <Border Classes="editorRow" Margin="0,0,0,3" IsEnabled="{Binding CanEdit}">
    <Grid ColumnDefinitions="*,Auto">
      <WrapPanel Grid.Column="0" Orientation="Horizontal">
        <StackPanel Classes="field" Width="250">
          <TextBlock Classes="fieldLabel" Text="SENTENCE" />
          <TextBox Text="{Binding Text}" Watermark="Line 01 permit must be given"
                   AutomationProperties.Name="Condition sentence" />
        </StackPanel>
        <StackPanel Classes="field" Width="185">
          <TextBlock Classes="fieldLabel" Text="TAG" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ComboBox Width="155" ItemsSource="{Binding TagEntries}" SelectedItem="{Binding SelectedBlockTag}"
                      AutomationProperties.Name="Condition tag"
                      ToolTip.Tip="One of this area's tags — assigned in the Tags tab, read by every block of the area.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicTagEntryViewModel">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="tool" Content="✕" Command="{Binding ClearBlockTagCommand}"
                    IsVisible="{Binding HasBlockTag}" VerticalAlignment="Center"
                    ToolTip.Tip="Clear the tag this row reads"
                    AutomationProperties.Name="Clear tag" />
          </StackPanel>
          <TextBlock Classes="hint" Margin="0,2,0,0" MaxWidth="170" TextWrapping="Wrap"
                     Text="{Binding StoredTagText}" IsVisible="{Binding HasStoredTag}" />
        </StackPanel>
        <StackPanel Classes="field" Width="130">
          <TextBlock Classes="fieldLabel" Text="OP" />
          <ComboBox ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op}"
                    AutomationProperties.Name="Condition operator">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="logic:LogicSelectOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Classes="field" Width="72" IsVisible="{Binding NeedsValue}">
          <TextBlock Classes="fieldLabel" Text="VALUE" />
          <TextBox Text="{Binding ValueText}" Watermark="value"
                   AutomationProperties.Name="Comparison value" />
        </StackPanel>
        <StackPanel Classes="field" Width="72">
          <TextBlock Classes="fieldLabel" Text="OR GROUP" />
          <TextBox Text="{Binding Group}" Watermark="none"
                   AutomationProperties.Name="OR group"
                   ToolTip.Tip="Conditions sharing a group are any-of; everything else is AND." />
        </StackPanel>
        <StackPanel Classes="field" Width="60">
          <TextBlock Classes="fieldLabel" Text="HOLD s" />
          <TextBox Text="{Binding HoldSeconds}" Watermark="0"
                   AutomationProperties.Name="Hold seconds"
                   ToolTip.Tip="TON on-delay: the contact counts only after holding this long." />
        </StackPanel>
        <StackPanel Classes="field" Width="95">
          <TextBlock Classes="fieldLabel" Text="SEVERITY" />
          <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}"
                    AutomationProperties.Name="Condition severity">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="logic:LogicSelectOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Classes="field" Width="185">
          <TextBlock Classes="fieldLabel" Text="NEXT STEP" />
          <TextBox Text="{Binding NextStepText}" Watermark="What to do next"
                   AutomationProperties.Name="Next step text" />
        </StackPanel>
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,0,3" VerticalAlignment="Top">
        <StackPanel MinWidth="44">
          <TextBlock Classes="fieldLabel" Text="LIVE" />
          <TextBlock Classes="mono" FontSize="11" TextAlignment="Center" Text="{Binding LiveText}"
                     Classes.stateOk="{Binding IsLiveOk}"
                     Classes.stateBad="{Binding IsLiveBad}"
                     Classes.stateWarn="{Binding IsLiveWarn}"
                     AutomationProperties.LiveSetting="Polite"
                     ToolTip.Tip="Live state: 1 / 0 / no data for a bit, the value for a comparison." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
          <Button Classes="tool" Content="+↑" Command="{Binding InsertAboveCommand}"
                  ToolTip.Tip="Insert a new condition above this row"
                  AutomationProperties.Name="Insert condition above" />
          <Button Classes="tool" Content="+↓" Command="{Binding InsertBelowCommand}"
                  ToolTip.Tip="Insert a new condition below this row"
                  AutomationProperties.Name="Insert condition below" />
          <Button Classes="tool" Content="↑" Command="{Binding MoveUpCommand}"
                  ToolTip.Tip="Move this condition up"
                  AutomationProperties.Name="Move condition up" />
          <Button Classes="tool" Content="↓" Command="{Binding MoveDownCommand}"
                  ToolTip.Tip="Move this condition down"
                  AutomationProperties.Name="Move condition down" />
          <Button Classes="tool" Content="✕" Command="{Binding RemoveCommand}"
                  AutomationProperties.Name="Remove condition" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
