<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpcBridge.Hmi.Views.LogicGuideWindow"
        Title="Logic guide"
        FontSize="11"
        Width="760"
        Height="640"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Classes="primary" Content="Close" Click="OnCloseClick" IsCancel="True" MinWidth="90" />
      <TextBlock Classes="hint"
                 VerticalAlignment="Center"
                 Text="How the plant logic is authored here and evaluated by the bridge." />
    </StackPanel>
    <Border BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="Guide" TextWrapping="Wrap" LineHeight="18" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
