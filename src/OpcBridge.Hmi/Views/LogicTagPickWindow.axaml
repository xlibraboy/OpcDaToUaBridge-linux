<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
        x:Class="OpcBridge.Hmi.Views.LogicTagPickWindow"
        x:DataType="logic:LogicTagPickViewModel"
        Title="{Binding Title}"
        FontSize="11"
        Width="700"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Classes="primary"
              Content="Add tags"
              Click="OnConfirmClick"
              IsEnabled="{Binding CanConfirm}"
              AutomationProperties.Name="Add the picked tags"
              MinWidth="110" />
      <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" MinWidth="90" />
      <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Hint}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBox x:Name="FilterBox" AutomationProperties.Name="Filter tags"
               Watermark="Filter tags…" Text="{Binding Filter}" />
      <Grid ColumnDefinitions="*,2*,*,Auto">
        <TextBlock Grid.Column="0" Classes="listHeader" Text="SOURCE" />
        <TextBlock Grid.Column="1" Classes="listHeader" Text="TAG" />
        <TextBlock Grid.Column="2" Classes="listHeader" Text="VALUE" />
      </Grid>
    </StackPanel>

    <Panel>
      <ListBox x:Name="TagList"
               ItemsSource="{Binding Rows}"
               SelectionMode="Multiple"
               AutomationProperties.Name="Bridge tags"
               AutomationProperties.HelpText="Tags the area's tags already hold are disabled. Use Ctrl or Shift with the arrow keys to select several.">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding Enabled, x:DataType=logic:LogicTagPickRow}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="logic:LogicTagPickRow">
            <Grid ColumnDefinitions="*,2*,*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="mono" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Classes="hint" Margin="10,0,0,0"
                         IsVisible="{Binding HasMarker}"
                         Text="{Binding Marker}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="hint" Margin="8" TextWrapping="Wrap" VerticalAlignment="Top"
                 Text="{Binding EmptyText}" IsVisible="{Binding ShowsEmptyText}" />
    </Panel>
  </DockPanel>
</Window>
