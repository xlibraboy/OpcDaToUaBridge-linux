<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicElementRowView"
             x:DataType="logic:LogicElementRowViewModel">
  <Grid ColumnDefinitions="265,260,Auto,125,80,Auto" Margin="{Binding IndentMargin}">
    <ComboBox Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
              AutomationProperties.Name="Element kind">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicSelectOption">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Text}"
             Watermark="Operator sentence / label" AutomationProperties.Name="Element label" />
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
      <ComboBox Width="130" IsVisible="{Binding IsContact}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                AutomationProperties.Name="Element source"
                ToolTip.Tip="{Binding SelectedSource.Label}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="logic:LogicSourceOption">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Width="190" IsVisible="{Binding IsContact}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTag}"
                AutomationProperties.Name="Element tag"
                ToolTip.Tip="{Binding SelectedTag.Detail}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="logic:LogicTagOption">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Width="175" IsVisible="{Binding IsContact}" ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op}"
                AutomationProperties.Name="Contact operator">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="logic:LogicSelectOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Width="80" IsVisible="{Binding NeedsValue}" Text="{Binding ValueText}" Watermark="value"
               AutomationProperties.Name="Comparison value" />
      <TextBox Width="90" IsVisible="{Binding IsTimer}" Text="{Binding PtSeconds}" Watermark="PT s"
               AutomationProperties.Name="Timer preset seconds"
               ToolTip.Tip="Preset time (PT) in seconds." />
      <TextBox Width="90" IsVisible="{Binding IsCounter}" Text="{Binding PvText}" Watermark="PV"
               AutomationProperties.Name="Counter preset"
               ToolTip.Tip="Preset count (PV)." />
    </StackPanel>
    <ComboBox Grid.Column="3" Margin="4,0,4,0" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}"
              AutomationProperties.Name="Element severity">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="logic:LogicSelectOption">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Column="4" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding LiveText}"
               Classes.stateOk="{Binding IsLiveOk}"
               Classes.stateBad="{Binding IsLiveBad}"
               Classes.stateWarn="{Binding IsLiveWarn}"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
      <Button Classes="tool" Content="→" Command="{Binding IndentRowCommand}"
              ToolTip.Tip="Make this row an input of the row above" AutomationProperties.Name="Indent element" />
      <Button Classes="tool" Content="←" Command="{Binding OutdentRowCommand}"
              ToolTip.Tip="Move this row out one level" AutomationProperties.Name="Outdent element" />
      <Button Classes="tool" Content="✕" Command="{Binding RemoveElementCommand}"
              AutomationProperties.Name="Remove element" />
    </StackPanel>
  </Grid>
</UserControl>
