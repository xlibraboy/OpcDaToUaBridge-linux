<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicElementRowView"
             x:DataType="logic:LogicElementRowViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- The nesting rail: one guide per enclosing level, beside the row card. -->
    <ItemsControl Grid.Column="0" ItemsSource="{Binding Guides}" Margin="8,0,0,0"
                  VerticalAlignment="Stretch">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter">
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="18" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource GridLineBrush}"
                  VerticalAlignment="Stretch" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- One element, as its own row. Only the fields the kind reads are shown: a contact a tag
         (or a relay) and a reading, a coil the relay it drives, a timer its preset, a counter its
         preset, a gate just its label. -->
    <Border Grid.Column="1" Classes="editorRow" Margin="0,0,0,6" IsEnabled="{Binding CanEdit}">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal">
          <StackPanel Classes="field" Width="250">
            <TextBlock Classes="fieldLabel" Text="KIND" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
                      AutomationProperties.Name="Element kind">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicSelectOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Classes="field" Width="260">
            <TextBlock Classes="fieldLabel" Text="SENTENCE / LABEL" />
            <TextBox Text="{Binding Text}" Watermark="Guard closed"
                     AutomationProperties.Name="Element label" />
          </StackPanel>
          <StackPanel Classes="field" Width="150" IsVisible="{Binding ShowsTagFields}">
            <TextBlock Classes="fieldLabel" Text="SOURCE" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      AutomationProperties.Name="Element source"
                      AutomationProperties.HelpText="{Binding SelectedSource.Detail}"
                      ToolTip.Tip="Source of the tag this row reads — or, on a relay row, of the tag the M's state is shown on.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicSourceOption">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Classes="field" Width="210" IsVisible="{Binding ShowsTagFields}">
            <TextBlock Classes="fieldLabel" Text="TAG" />
            <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTag}"
                      AutomationProperties.Name="Element tag"
                      AutomationProperties.HelpText="{Binding SelectedTag.Detail}"
                      ToolTip.Tip="On a relay row this is the tag the M is bound to: the relay drives its value and the write policy below decides who may write it. Blank = the M is the bridge's memory only.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicTagOption">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Classes="field" Width="150" IsVisible="{Binding ShowsRelay}">
            <TextBlock Classes="fieldLabel" Text="RELAY" />
            <AutoCompleteBox ItemsSource="{Binding RelayNames}" Text="{Binding Relay}"
                             FilterMode="Contains" Watermark="M01"
                             AutomationProperties.Name="Internal relay"
                             ToolTip.Tip="Internal relay (e.g. M01). On a contact it reads the relay; on a coil it drives one — any block can read it." />
          </StackPanel>
          <StackPanel Classes="field" Width="140" IsVisible="{Binding ShowsRelayWrite}">
            <TextBlock Classes="fieldLabel" Text="WRITE" />
            <ComboBox ItemsSource="{Binding RelayWriteOptions}" SelectedItem="{Binding RelayWrite}"
                      AutomationProperties.Name="Relay tag write policy"
                      ToolTip.Tip="Who may write this tag. Auto: while no coil drives the M the tag is the operator's, while the logic drives it the tag only shows the state. Always: a write pokes the M and the coil overwrites it on the next pass. Never: the tag is read-only.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicSelectOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Classes="field" Width="170" IsVisible="{Binding IsContact}">
            <TextBlock Classes="fieldLabel" Text="OP" />
            <ComboBox ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op}"
                      AutomationProperties.Name="Contact operator">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicSelectOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Classes="field" Width="90" IsVisible="{Binding NeedsValue}">
            <TextBlock Classes="fieldLabel" Text="VALUE" />
            <TextBox Text="{Binding ValueText}" Watermark="value"
                     AutomationProperties.Name="Comparison value" />
          </StackPanel>
          <StackPanel Classes="field" Width="90" IsVisible="{Binding IsTimer}">
            <TextBlock Classes="fieldLabel" Text="PT s" />
            <TextBox Text="{Binding PtSeconds}" Watermark="3"
                     AutomationProperties.Name="Timer preset seconds"
                     ToolTip.Tip="Preset time (PT) in seconds." />
          </StackPanel>
          <StackPanel Classes="field" Width="90" IsVisible="{Binding IsCounter}">
            <TextBlock Classes="fieldLabel" Text="PV" />
            <TextBox Text="{Binding PvText}" Watermark="5"
                     AutomationProperties.Name="Counter preset"
                     ToolTip.Tip="Preset count (PV)." />
          </StackPanel>
          <StackPanel Classes="field" Width="110">
            <TextBlock Classes="fieldLabel" Text="SEVERITY" IsVisible="{Binding ShowsSeverity}" />
            <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}"
                      IsVisible="{Binding ShowsSeverity}"
                      AutomationProperties.Name="Element severity">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="logic:LogicSelectOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Top">
          <StackPanel MinWidth="52">
            <TextBlock Classes="fieldLabel" Text="LIVE" />
            <TextBlock Classes="mono" FontSize="13" TextAlignment="Center" Text="{Binding LiveText}"
                       Classes.stateOk="{Binding IsLiveOk}"
                       Classes.stateBad="{Binding IsLiveBad}"
                       Classes.stateWarn="{Binding IsLiveWarn}"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
            <Button Classes="tool" Content="→" Command="{Binding IndentRowCommand}"
                    ToolTip.Tip="Make this row an input of the row above" AutomationProperties.Name="Indent element" />
            <Button Classes="tool" Content="←" Command="{Binding OutdentRowCommand}"
                    ToolTip.Tip="Move this row out one level" AutomationProperties.Name="Outdent element" />
            <Button Classes="tool" Content="✕" Command="{Binding RemoveElementCommand}"
                    AutomationProperties.Name="Remove element" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
