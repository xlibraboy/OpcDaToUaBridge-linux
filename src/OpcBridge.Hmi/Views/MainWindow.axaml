<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:client="using:OpcBridge.Client"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpcBridge HMI"
        Width="1280"
        Height="800">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0"
               Watermark="Bridge Base URL"
               Text="{Binding BaseUrl}"
               Margin="0,0,8,0" />
      <Button Grid.Column="1"
              Content="Connect"
              Command="{Binding ConnectCommand}"
              Margin="0,0,8,0"
              MinWidth="96" />
      <Button Grid.Column="2"
              Content="Disconnect"
              Command="{Binding DisconnectCommand}"
              Margin="0,0,8,0"
              MinWidth="96" />
      <TextBlock Grid.Column="3"
                 VerticalAlignment="Center"
                 Text="{Binding ConnectionState, StringFormat=Status: {0}}" />
    </Grid>

    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Display store:" />
      <TextBox Width="220"
               Watermark="http://primary:8080"
               Text="{Binding DisplayStoreUrl}" />
      <Button Content="Refresh"
              Command="{Binding RefreshDisplaysCommand}"
              MinWidth="80" />
      <ComboBox Width="200"
                ItemsSource="{Binding Displays}"
                SelectedItem="{Binding SelectedDisplay}"
                PlaceholderText="Select display">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="client:DisplayListItemDto">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Load display"
              Command="{Binding LoadSelectedDisplayCommand}"
              MinWidth="110" />
      <TextBlock VerticalAlignment="Center" Text="Filter:" />
      <TextBox Width="160"
               Watermark="tags filter"
               Text="{Binding Filter}" />
      <TextBlock VerticalAlignment="Center"
                 Text="{Binding BridgeSummary, StringFormat=Bridges: {0}}"
                 Opacity="0.85" />
    </StackPanel>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left"
                 VerticalAlignment="Top"
                 Margin="0,4,8,0"
                 Text="Extra bridges:" />
      <TextBox AcceptsReturn="True"
               TextWrapping="NoWrap"
               Height="54"
               Watermark="line2|http://192.168.1.11:8080"
               Text="{Binding BridgeListText}" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Text="{Binding StatusMessage}"
               TextWrapping="Wrap"
               Opacity="0.85" />

    <Grid ColumnDefinitions="3*,2*">
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"
                   Text="{Binding DisplaySurface.DisplayName, StringFormat=Process display: {0}}" />
        <controls:DisplaySurfaceControl DataContext="{Binding DisplaySurface}" />
      </DockPanel>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Tag browser" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Open faceplate"
                    Command="{Binding OpenFaceplateCommand}"
                    HorizontalAlignment="Right"
                    MinWidth="120" />
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding SelectedTag.BridgeId, StringFormat=Bridge: {0}}" />
            <TextBlock Text="{Binding SelectedTag.DisplayName, StringFormat=Name: {0}}" />
            <TextBlock Text="{Binding SelectedTag.ValueText, StringFormat=Value: {0}}" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="Double-click tag or click widget to open faceplate. Open trend from faceplate." />
          </StackPanel>
          <ListBox ItemsSource="{Binding FilteredTags}"
                   SelectedItem="{Binding SelectedTag}"
                   DoubleTapped="OnTagDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TagItemViewModel">
                <Grid ColumnDefinitions="*,2*,*">
                  <TextBlock Grid.Column="0" Text="{Binding BridgeId}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
