<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        xmlns:client="using:OpcBridge.Client"
        xmlns:controls="using:OpcBridge.Hmi.Controls"
        x:Class="OpcBridge.Hmi.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpcBridge HMI"
        Width="1280"
        Height="800">
  <DockPanel>
    <!-- ======== Menu bar ======== -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
        <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Home" Command="{Binding ShowHomeCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding IsHomePage, Mode=OneWay}"
                  InputGesture="Ctrl+1" />
        <MenuItem Header="Config" Command="{Binding ShowConfigCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding IsConfigPage, Mode=OneWay}"
                  InputGesture="Ctrl+2" />
        <Separator />
        <MenuItem Header="Open faceplate" Command="{Binding OpenFaceplateCommand}" />
        <MenuItem Header="Refresh displays" Command="{Binding RefreshDisplaysCommand}" />
      </MenuItem>
      <MenuItem Header="Confi_g">
        <MenuItem Header="Connection and display settings" Command="{Binding ShowConfigCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- ======== Status strip ======== -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
      <DockPanel>
        <Border Classes="pill ok" IsVisible="{Binding IsConnected}">
          <TextBlock Text="{Binding ConnectionState}" />
        </Border>
        <Border Classes="pill bad" IsVisible="{Binding !IsConnected}">
          <TextBlock Text="{Binding ConnectionState}" />
        </Border>
        <TextBlock DockPanel.Dock="Right"
                   Classes="hint"
                   VerticalAlignment="Center"
                   MaxWidth="520"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusMessage}" />
        <TextBlock Margin="12,0,0,0"
                   Classes="hint"
                   VerticalAlignment="Center"
                   Text="{Binding BridgeSummary, StringFormat=Bridges: {0}}" />
      </DockPanel>
    </Border>

    <!-- ======== Content pages ======== -->
    <Grid>

      <!-- ======== HOME ======== -->
      <Grid IsVisible="{Binding IsHomePage}"
            RowDefinitions="Auto,*,Auto"
            Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="cardTitle" Text="Connection" />
              <TextBlock Classes="cardValue" Text="{Binding ConnectionState}" />
              <TextBlock Classes="hint" Text="{Binding BaseUrl}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="cardTitle" Text="Bridges" />
              <TextBlock Classes="cardValue"
                         Text="{Binding BridgeSummary, TargetNullValue=—}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" Text="Connected bridge ids" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="cardTitle" Text="Process display" />
              <TextBlock Classes="cardValue" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" IsVisible="{Binding !HasDisplay}" Text="Load one from Config" />
              <TextBlock Classes="hint" IsVisible="{Binding HasDisplay}" Text="Live view below" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card">
            <StackPanel>
              <TextBlock Classes="cardTitle" Text="Live tags" />
              <TextBlock Classes="cardValue" Text="{Binding TagCount}" />
              <TextBlock Classes="hint" Text="Cached tag values" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Process display (the SCADA overview) -->
        <Panel Grid.Row="1" IsVisible="{Binding HasDisplay}">
          <controls:DisplaySurfaceControl DataContext="{Binding DisplaySurface}" />
        </Panel>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Classes="cardDark"
                IsVisible="{Binding !HasDisplay}"
                Padding="32">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      MaxWidth="420">
            <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Text="No process display loaded" />
            <TextBlock Classes="hint" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Connect to the bridge, then pick a display from the store. Displays are designed in OpcBridge HMI Designer." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
              <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" />
              <Button Content="Open Config" Command="{Binding ShowConfigCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Classes="hint"
                   Margin="0,8,0,0"
                   Text="{Binding DisplaySurface.StatusMessage}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <!-- ======== CONFIG ======== -->
      <Grid IsVisible="{Binding IsConfigPage}" ColumnDefinitions="640,*" Margin="12">
        <!-- Bridge lines -->
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">

          <Border Classes="card">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="sectionLabel" Text="BRIDGES" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" />
                <Button Classes="danger" Content="Disconnect" Command="{Binding DisconnectCommand}" />
                <Rectangle Classes="vsep" />
                <Button Content="+ Add bridge" Command="{Binding AddBridgeCommand}" />
              </StackPanel>

              <StackPanel>
                <Grid ColumnDefinitions="2.1*,2.1*,1.1*,Auto,Auto" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Classes="listHeader" Text="OPCBRIDGE ADDRESS" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="1" Classes="listHeader" Text="DISPLAY STORE" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="2" Classes="listHeader" Text="NAME" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="3" Classes="listHeader" Text="STATUS" Margin="8,0,8,0" />
                  <TextBlock Grid.Column="4" Classes="listHeader" Text="" />
                </Grid>
                <ItemsControl ItemsSource="{Binding BridgeRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BridgeRow">
                      <Grid ColumnDefinitions="2.1*,2.1*,1.1*,Auto,Auto" Margin="0,2">
                        <TextBox Grid.Column="0"
                                 Margin="0,0,4,0"
                                 Watermark="http://127.0.0.1:8080"
                                 Text="{Binding Address}" />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,4,0"
                                 Watermark="= address"
                                 Text="{Binding DisplayStore}" />
                        <TextBox Grid.Column="2"
                                 Margin="0,0,4,0"
                                 Watermark="name"
                                 Text="{Binding Name}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="8,0,8,0" VerticalAlignment="Center">
                          <Ellipse Width="9" Height="9" IsVisible="{Binding IsConnected}" Fill="{DynamicResource OkBorderBrush}" />
                          <Ellipse Width="9" Height="9" IsVisible="{Binding !IsConnected}" Fill="{DynamicResource CardBorderBrush}" />
                          <TextBlock Text="{Binding ScopeKind}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="4" Classes="tool" Content="✕"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveBridgeCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionLabel" Text="DISPLAY STORE" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Command="{Binding RefreshDisplaysCommand}" MinWidth="80" />
                <ComboBox Width="430"
                          ItemsSource="{Binding Displays}"
                          SelectedItem="{Binding SelectedDisplay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DisplayEntry">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Button Content="Load display" Command="{Binding LoadSelectedDisplayCommand}" MinWidth="110"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Tag browser -->
        <Border Grid.Column="1" Classes="card">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Tag browser" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Open faceplate"
                      Command="{Binding OpenFaceplateCommand}"
                      HorizontalAlignment="Right"
                      MinWidth="120" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
              <TextBox Watermark="Filter tags…" Text="{Binding Filter}" />
              <Grid ColumnDefinitions="*,2*,*">
                <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE" />
                <TextBlock Grid.Column="1" Classes="listHeader" Text="TAG" />
                <TextBlock Grid.Column="2" Classes="listHeader" Text="VALUE" />
              </Grid>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="{Binding SelectedTag.BridgeId, StringFormat=Bridge: {0}}" />
              <TextBlock Text="{Binding SelectedTag.DisplayName, StringFormat=Name: {0}}" />
              <TextBlock Text="{Binding SelectedTag.ValueText, StringFormat=Value: {0}}" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Double-click tag or click widget to open faceplate. Open trend from faceplate." />
            </StackPanel>

            <ListBox ItemsSource="{Binding FilteredTags}"
                     SelectedItem="{Binding SelectedTag}"
                     DoubleTapped="OnTagDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TagItemViewModel">
                  <Grid ColumnDefinitions="*,2*,*">
                    <TextBlock Grid.Column="0" Text="{Binding BridgeId}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="valueText" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
