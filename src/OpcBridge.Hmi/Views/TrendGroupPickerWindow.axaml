<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        x:Class="OpcBridge.Hmi.Views.TrendGroupPickerWindow"
        x:DataType="vm:MainViewModel"
        Title="Group trend"
        FontSize="11"
        Width="560"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Classes="primary" Content="Open trend" Click="OnOpenTrendClick" MinWidth="110" />
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
      <TextBlock Classes="hint"
                 VerticalAlignment="Center"
                 Text="Select two or more tags to plot on one chart. Tags without InfluxDB history are disabled." />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBox Watermark="Filter tags…" Text="{Binding Filter}" />
      <Grid ColumnDefinitions="*,2*,*">
        <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE" />
        <TextBlock Grid.Column="1" Classes="listHeader" Text="TAG" />
        <TextBlock Grid.Column="2" Classes="listHeader" Text="VALUE" />
      </Grid>
    </StackPanel>

    <ListBox x:Name="TagList"
             ItemsSource="{Binding FilteredTags}"
             SelectionMode="Multiple">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="IsEnabled" Value="{Binding CanTrend, x:DataType=vm:TagItemViewModel}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TagItemViewModel">
          <Grid ColumnDefinitions="*,2*,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding BridgeId}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Classes="valueText" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Classes="hint" Margin="8,0,0,0"
                       IsVisible="{Binding !CanTrend}"
                       Text="{Binding AvailabilityMarker}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>