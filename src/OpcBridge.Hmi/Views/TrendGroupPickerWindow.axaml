<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcBridge.Hmi.ViewModels"
        x:Class="OpcBridge.Hmi.Views.TrendGroupPickerWindow"
        x:DataType="vm:TagPickerViewModel"
        Title="{Binding Title}"
        FontSize="11"
        Width="640"
        Height="540"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Classes="primary"
              Content="{Binding ConfirmText}"
              Click="OnConfirmClick"
              IsEnabled="{Binding CanConfirm}"
              MinWidth="110" />
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
      <TextBlock Classes="hint"
                 VerticalAlignment="Center"
                 Text="Tags without InfluxDB history are disabled." />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding AskForName}" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Classes="listHeader" Text="GROUP NAME" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" Watermark="Name of the trend group" Text="{Binding GroupName}" />
      </Grid>
      <TextBox Watermark="Filter tags…" Text="{Binding Filter}" />
      <Grid ColumnDefinitions="*,*,2*,Auto">
        <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE" />
        <TextBlock Grid.Column="1" Classes="listHeader" Text="SOURCE" />
        <TextBlock Grid.Column="2" Classes="listHeader" Text="TAG" />
      </Grid>
    </StackPanel>

    <ListBox x:Name="TagList"
             ItemsSource="{Binding Rows}"
             SelectionMode="Multiple">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="IsEnabled" Value="{Binding Enabled, x:DataType=vm:TagListRow}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TagListRow">
          <Grid ColumnDefinitions="*,*,2*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding BridgeId}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding SourceName}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Classes="hint" Margin="10,0,0,0"
                       IsVisible="{Binding HasMarker}"
                       Text="{Binding Marker}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
