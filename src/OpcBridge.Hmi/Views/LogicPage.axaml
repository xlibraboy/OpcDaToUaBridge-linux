<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logic="using:OpcBridge.Hmi.ViewModels.Logic"
             x:Class="OpcBridge.Hmi.Views.LogicPage"
             x:DataType="logic:LogicPageViewModel">
  <!-- The page hosts the bridge's own /logic page; the density styles only keep its bridge
       selector and buttons on the same compact metrics the page used before the editor retired. -->
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="8">

    <!-- ======== Bridge selector ======== -->
    <Border Grid.Row="0" Classes="card">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" MinWidth="200"
                  ItemsSource="{Binding Bridges}" SelectedItem="{Binding SelectedBridge}"
                  AutomationProperties.Name="Logic bridge"
                  ToolTip.Tip="The bridge whose plant logic is shown here.">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="logic:LogicBridgeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Column="2" Margin="10,0,0,0" Classes="pill"
                Classes.ok="{Binding IsBridgeOk}"
                Classes.warn="{Binding IsBridgeWarn}"
                Classes.bad="{Binding IsBridgeBad}">
          <TextBlock Text="{Binding BridgeStatusText}" AutomationProperties.LiveSetting="Polite" />
        </Border>
      </Grid>
    </Border>

    <!-- ======== The bridge's own /logic page ========
         The bridge serves the page and its data, so it is same-origin with /api/logic* and the
         /hmi hub. On Windows it is embedded with WebView2; elsewhere it opens in the browser. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,6,0,0">
      <Border Grid.Row="0" Classes="card" Margin="0,0,0,6">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="listHeader" Text="BRIDGE PAGE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center"
                       Text="{Binding WebPageUrl}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WebPageUrl}"
                       AutomationProperties.Name="Logic web page address" />
            <Button x:Name="ReloadWebButton" Grid.Column="2" Content="Reload"
                    Click="OnReloadWebClick"
                    AutomationProperties.Name="Reload the embedded logic page"
                    IsVisible="False" />
            <Button Grid.Column="3" Classes="primary" Content="Open in browser"
                    Click="OnOpenInBrowserClick"
                    IsEnabled="{Binding HasWebPageUrl}"
                    AutomationProperties.Name="Open the logic page in the system browser"
                    ToolTip.Tip="Open this bridge's /logic page in the system browser — the same page, in a separate window." />
          </Grid>
          <TextBlock x:Name="WebStatusText" Classes="hint warn" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
      </Border>
      <Panel Grid.Row="1">
        <ContentControl x:Name="WebHost" IsVisible="False" />
        <StackPanel x:Name="WebFallback" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="560" Spacing="10" Margin="0,24">
          <TextBlock x:Name="WebFallbackTitle" FontSize="16" FontWeight="SemiBold"
                     HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="WebFallbackMessage" Classes="hint" TextAlignment="Center" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Classes="primary" Content="Open in browser" Click="OnOpenInBrowserClick"
                    IsEnabled="{Binding HasWebPageUrl}" />
            <Button x:Name="RetryWebButton" Content="Retry" Click="OnReloadWebClick" IsVisible="False" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
