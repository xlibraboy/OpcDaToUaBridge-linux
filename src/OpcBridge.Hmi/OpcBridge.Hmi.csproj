<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The runtime versions and releases on its own (hmi-v* tags, HmiVersion
         in Directory.Build.props) instead of the server's version. -->
    <Version>$(HmiVersion)</Version>
    <!-- Icon embedded in the published apphost and in the window frame (App.axaml sets
         it on every Window), so Explorer, the Start Menu shortcut, the title bar and the
         taskbar all show it instead of a blank. Generated by scripts/icons/make-icons.py. -->
    <ApplicationIcon>Assets/opcbridge-hmi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/opcbridge-hmi.ico" />
  </ItemGroup>
  <!-- The release notes ship inside the assembly: Help ▸ Release notes shows the
       embedded CHANGELOG.md, so the app and the file can never disagree. -->
  <ItemGroup>
    <None Remove="CHANGELOG.md" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="OpcBridge.Hmi.CHANGELOG.md" />
  </ItemGroup>
  <!-- The Logic page's guide ships the same way (its Guide… button). -->
  <ItemGroup>
    <None Remove="Help/LogicGuide.md" />
    <EmbeddedResource Include="Help/LogicGuide.md" LogicalName="OpcBridge.Hmi.LogicGuide.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <!-- The Logic page's embedded web view. Only the Windows backend is referenced: the HMI
         embeds /logic with WebView2 on Windows and opens the page in the system browser
         elsewhere, where a GTK/WebKit control would fight Avalonia's own HarfBuzz. -->
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Windows" Version="11.0.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpcBridge.Client\OpcBridge.Client.csproj" />
    <ProjectReference Include="..\OpcBridge.Core\OpcBridge.Core.csproj" />
    <ProjectReference Include="..\OpcBridge.Hmi.Core\OpcBridge.Hmi.Core.csproj" />
  </ItemGroup>
</Project>
