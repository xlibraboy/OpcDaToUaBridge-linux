<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Card panel -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.cardDark">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.cardValue">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="TextBlock.listHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
  </Style>

  <Style Selector="TextBlock.valueText">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Vertical toolbar separator -->
  <Style Selector="Rectangle.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Fill" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Status pills -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.ok > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
  </Style>

  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.bad > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
  </Style>

  <Style Selector="Border.pill.muted">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.muted > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#0E639C" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1177BB" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#0B5184" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
    <Setter Property="MinWidth" Value="96" />
  </Style>

  <Style Selector="Button.tool">
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Segmented range buttons (trend) -->
  <Style Selector="RadioButton.seg">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton.seg /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="RadioButton.seg:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#0E639C" />
    <Setter Property="BorderBrush" Value="#1177BB" />
  </Style>

  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Menu item accent check -->
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="10,5" />
  </Style>
</Styles>
