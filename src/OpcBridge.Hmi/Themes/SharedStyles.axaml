<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The window is the canvas everything else sits on, and it sets the colour every
       descendant text inherits unless the text says otherwise (buttons, pills, warnings). -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Selected rows carry the accent family rather than the theme's own blue. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <!-- Card panel -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.cardDark">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.cardValue">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!-- Warning text (e.g. trend disabled because a tag has no InfluxDB history) -->
  <Style Selector="TextBlock.hint.warn">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
  </Style>

  <!-- Text that is present but cannot be used right now -->
  <Style Selector="TextBlock.disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
  </Style>

  <Style Selector="TextBlock.listHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
  </Style>

  <Style Selector="TextBlock.valueText">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Vertical toolbar separator -->
  <Style Selector="Rectangle.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Fill" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Status pills -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.ok > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
  </Style>

  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.bad > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
  </Style>

  <Style Selector="Border.pill.muted">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
  </Style>

  <Style Selector="Border.pill.muted > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
    <Setter Property="MinWidth" Value="96" />
  </Style>

  <Style Selector="Button.tool">
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Segmented range buttons (trend) -->
  <Style Selector="RadioButton.seg">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton.seg /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="RadioButton.seg:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Flat button: no chrome, hit area larger than the glyph it draws -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.flat /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
  </Style>

  <Style Selector="Button.flat:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FrameBrush}" />
  </Style>

  <Style Selector="Button.flat:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentValueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Focus ring for rows and bars that draw their own chrome instead of a template.
       BoxShadow takes a literal: Avalonia parses the shadow in the setter, so this is the
       one place the accent value appears as text rather than through the token. -->
  <Style Selector="Border.focusRing:focus-visible">
    <Setter Property="BoxShadow" Value="inset 0 0 0 2 #74BDEF" />
  </Style>

  <!-- Menu item accent check -->
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="10,5" />
  </Style>
</Styles>
