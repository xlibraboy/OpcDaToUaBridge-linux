<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpcBridge.Client\OpcBridge.Client.csproj" />
    <ProjectReference Include="..\OpcBridge.Core\OpcBridge.Core.csproj" />
  </ItemGroup>

  <!-- Publish-only: the test project references both this app and the bridge, and two
       appsettings.json copies would collide in its output folder. Local runs use the code
       defaults (Logic:HttpPort 8090, Bridge:BaseUrl empty = discover on the port range);
       environment variables override either when needed. -->
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- The release notes are shipped inside the assembly and served at /api/changelog,
       so the app and CHANGELOG.md can never disagree. -->
  <ItemGroup>
    <None Remove="CHANGELOG.md" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="OpcBridge.Logic.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpcBridge.LoadTest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Logic web app versions and releases on its own (logic-v* tags,
         LogicVersion in Directory.Build.props) instead of the server's version. -->
    <Version>$(LogicVersion)</Version>
    <!-- Workstation GC, like the bridge: the app idles between 1 s state polls and the
         plant host is a 4 GB box where Server GC's per-core heaps are pure overhead. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Icon embedded in the published apphost, so Explorer, the Start Menu shortcut and
         the taskbar show the app instead of the generic .NET blank. Generated by
         scripts/icons/make-icons.py. -->
    <ApplicationIcon>Assets/opcbridge-logic.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
