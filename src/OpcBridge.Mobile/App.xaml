<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OpcBridge.Mobile"
             x:Class="OpcBridge.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Plant-floor palette: dark, high contrast, state colours that survive
                 glare and are always paired with a state word in the UI. -->
            <Color x:Key="PageBg">#0C1210</Color>
            <Color x:Key="SurfaceColor">#151D1A</Color>
            <Color x:Key="SurfaceAltColor">#1D2723</Color>
            <Color x:Key="BorderColor">#2A3631</Color>
            <Color x:Key="TextColor">#F1F5F3</Color>
            <Color x:Key="MutedColor">#93A19B</Color>
            <Color x:Key="GoodColor">#4CC38A</Color>
            <Color x:Key="BadColor">#E5484D</Color>
            <Color x:Key="WarnColor">#E2A336</Color>
            <Color x:Key="OnPrimaryColor">#07130D</Color>

            <local:StateColorConverter x:Key="StateColor" />
            <local:ChipColorConverter x:Key="ChipColor" />

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="TitleColor" Value="{StaticResource MutedColor}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinimumHeightRequest" Value="42" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
                <Setter Property="CancelButtonColor" Value="{StaticResource MutedColor}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBg}" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="ListCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style x:Key="SubtleBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style x:Key="InputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PillBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 5" />
                <Setter Property="Padding" Value="6,2" />
            </Style>
            <Style x:Key="LogoBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <!-- V2 console: one 44px field surface, icon-led, with no input chrome of its own. -->
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>
            <Style x:Key="SearchBorder" TargetType="Border" BasedOn="{StaticResource FieldBorder}">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>
            <Style x:Key="BlockCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>
            <Style x:Key="ElementCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="Padding" Value="9" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>
            <Style x:Key="LogicGroupCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HeightRequest" Value="38" />
            </Style>
            <Style x:Key="ElementsGroupCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style x:Key="BadgeBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HeightRequest" Value="18" />
            </Style>
            <Style x:Key="InsetBadgeBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
            </Style>
            <Style x:Key="ElementBadgeBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                <Setter Property="HeightRequest" Value="17" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 5" />
            </Style>
            <Style x:Key="MetaBadgeBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                <Setter Property="StrokeShape" Value="RoundRectangle 5" />
            </Style>
            <Style x:Key="MetaInsetBadgeBorder" TargetType="Border" BasedOn="{StaticResource InsetBadgeBorder}">
                <Setter Property="StrokeShape" Value="RoundRectangle 5" />
            </Style>
            <Style x:Key="OutputPillBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 7" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
            <Style x:Key="MetricCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="MinimumHeightRequest" Value="46" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource GoodColor}" />
                <Setter Property="TextColor" Value="{StaticResource OnPrimaryColor}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinimumHeightRequest" Value="38" />
            </Style>
            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinimumHeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="28" />
                <Setter Property="MinimumHeightRequest" Value="28" />
            </Style>
            <!-- V2 app-bar action: a square, bordered surface rather than a text button. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="WidthRequest" Value="34" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="MinimumWidthRequest" Value="34" />
                <Setter Property="MinimumHeightRequest" Value="34" />
            </Style>
            <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="WidthRequest" Value="26" />
                <Setter Property="HeightRequest" Value="26" />
                <Setter Property="MinimumWidthRequest" Value="26" />
                <Setter Property="MinimumHeightRequest" Value="26" />
            </Style>
            <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="HeightRequest" Value="26" />
                <Setter Property="MinimumHeightRequest" Value="26" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="ComposerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>
            <!-- Exact V2 square icon actions: a bordered surface with the Lucide mark centred.
                 The mark is an Image at its design size; ImageButton scales it to half. -->
            <Style x:Key="IconActionBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="34" />
                <Setter Property="HeightRequest" Value="34" />
            </Style>
            <Style x:Key="SmallActionBorder" TargetType="Border" BasedOn="{StaticResource IconActionBorder}">
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="WidthRequest" Value="26" />
                <Setter Property="HeightRequest" Value="26" />
            </Style>

            <Style x:Key="UppercaseLabel" TargetType="Label">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
            </Style>
            <Style x:Key="MetaLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
            </Style>
            <Style x:Key="SectionTitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="MonoLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="monospace" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
