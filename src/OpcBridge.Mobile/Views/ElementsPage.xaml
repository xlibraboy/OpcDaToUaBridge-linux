<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             x:Class="OpcBridge.Mobile.Views.ElementsPage"
             Title="Elements"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">
    <ContentPage.Resources>
        <!-- V2 segmented kind filter: one rail, the chosen segment raised on its own surface. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="MinimumHeightRequest" Value="30" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAltColor}" />
                    <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="2,0,4,0">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Plant elements" FontSize="22" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="connectionDot"
                               Text="●"
                               FontSize="7"
                               TextColor="{StaticResource MutedColor}"
                               VerticalOptions="Center" />
                        <Label x:Name="connectionLabel"
                               FontSize="10.5"
                               TextColor="{StaticResource MutedColor}"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button x:Name="refreshButton"
                            Text="↻"
                            Style="{StaticResource IconButton}"
                            Clicked="OnRefreshClicked"
                            SemanticProperties.Description="Refresh elements" />
                    <Button x:Name="syncButton"
                            Text="⇅"
                            Style="{StaticResource IconButton}"
                            Clicked="OnSyncNowClicked"
                            SemanticProperties.Description="Sync now" />
                </HorizontalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label x:Name="sourceDot"
                           Text="●"
                           FontSize="7"
                           TextColor="{StaticResource MutedColor}"
                           VerticalOptions="Center" />
                    <Label x:Name="sourceLabel"
                           FontFamily="monospace"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="{StaticResource MutedColor}"
                           TextTransform="Uppercase"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Grid.Column="2"
                       x:Name="summaryLabel"
                       FontSize="9.5"
                       TextColor="{StaticResource MutedColor}"
                       VerticalOptions="Center" />
                <Label Grid.Column="3"
                       Text="·"
                       FontSize="9"
                       TextColor="{StaticResource MutedColor}"
                       VerticalOptions="Center" />
                <views:SyncBadgeView x:Name="latencyBadge"
                                     Grid.Column="4"
                                     Uppercase="False"
                                     Hint=""
                                     VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource SearchBorder}">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="⌕"
                           FontSize="16"
                           TextColor="{StaticResource MutedColor}"
                           Margin="12,0,9,0"
                           VerticalOptions="Center" />
                    <Entry x:Name="searchEntry"
                           Grid.Column="1"
                           Margin="0,0,12,0"
                           BackgroundColor="Transparent"
                           Placeholder="Search element, tag or block"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 11"
                    Padding="3"
                    HeightRequest="36">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                    <Button x:Name="kindAllButton" Grid.Column="0" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindInterlockButton" Grid.Column="1" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindPermissiveButton" Grid.Column="2" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindSequenceButton" Grid.Column="3" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                </Grid>
            </Border>

            <Label x:Name="filterLabel"
                   FontSize="10.5"
                   TextColor="{StaticResource MutedColor}"
                   IsVisible="false" />
        </VerticalStackLayout>

        <RefreshView x:Name="refreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="elementsView" IsGrouped="True" SelectionMode="Single"
                            SelectionChanged="OnElementSelected">
                <CollectionView.EmptyView>
                    <Label x:Name="emptyLabel" TextColor="{StaticResource MutedColor}" Margin="8" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,4" Style="{StaticResource GroupCardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
                                    <Label Text="{Binding Chevron}" FontSize="11"
                                           VerticalOptions="Center" TextColor="{StaticResource MutedColor}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                                           MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" VerticalOptions="Center">
                                        <Label Text="{Binding KindLabel}" FontSize="8.5" FontAttributes="Bold"
                                               FontFamily="monospace"
                                               TextColor="{StaticResource MutedColor}" />
                                    </Border>
                                    <Label Grid.Column="4" Text="{Binding StateLabel}" FontSize="9.5"
                                           FontAttributes="Bold" VerticalOptions="Center"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                </Grid>
                                <Grid ColumnDefinitions="17,*,Auto" ColumnSpacing="8">
                                    <BoxView WidthRequest="17" HeightRequest="1" />
                                    <Label Grid.Column="1" Text="{Binding Meta}" FontSize="9.5"
                                           IsVisible="{Binding HasMeta}"
                                           TextColor="{StaticResource MutedColor}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Summary}" FontSize="9.5"
                                           TextColor="{StaticResource MutedColor}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*">
                            <views:DepthGuideView Grid.Column="0" WidthRequest="{Binding IndentWidth}"
                                                  Depth="{Binding Depth}" GuideColor="{StaticResource BorderColor}"
                                                  VerticalOptions="Fill" />
                            <Border Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource ElementCardBorder}">
                                <Grid ColumnDefinitions="16,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6" RowSpacing="3">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Mark}" FontSize="13"
                                           FontAttributes="Bold" VerticalOptions="Center"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Text}" FontSize="13" FontAttributes="Bold"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource BadgeBorder}" VerticalOptions="Center">
                                            <Label Text="{Binding KindLabel}" FontSize="8.5" FontAttributes="Bold"
                                                   FontFamily="monospace"
                                                   TextColor="{StaticResource MutedColor}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="0"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding ActualText}" FontSize="16" FontFamily="monospace"
                                               FontAttributes="Bold" HorizontalTextAlignment="End"
                                               TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                        <Label Text="{Binding ValueText}" FontSize="8.5" FontFamily="monospace"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource MutedColor}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StepLabel}"
                                           IsVisible="{Binding HasStep}" FontSize="9.5"
                                           TextColor="{StaticResource MutedColor}" />
                                    <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TagLabel}"
                                           IsVisible="{Binding HasTag}"
                                           FontFamily="monospace" FontSize="9.5"
                                           TextColor="{StaticResource MutedColor}"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ShouldLine}"
                                           IsVisible="{Binding ShowShould}" FontFamily="monospace" FontSize="10.5"
                                           TextColor="{Binding ShouldKey, Converter={StaticResource StateColor}}" />
                                    <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ProgressText}"
                                           IsVisible="{Binding ShowProgress}" FontSize="10.5"
                                           TextColor="{StaticResource WarnColor}" />
                                    <Label Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NextStepText}"
                                           IsVisible="{Binding ShowNextStep}" FontSize="10.5"
                                           TextColor="{StaticResource WarnColor}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
