<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             x:Class="OpcBridge.Mobile.Views.ElementsPage"
             Title="Elements"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">
    <ContentPage.Resources>
        <DataTemplate x:Key="FilterChip">
            <Button Text="{Binding Label}" Clicked="OnFilterChipClicked" FontSize="10" Padding="10,4" CornerRadius="9"
                    HeightRequest="26" MinimumHeightRequest="26"
                    BackgroundColor="{Binding IsSelected, Converter={StaticResource ChipColor}}"
                    TextColor="{Binding IsSelected, Converter={StaticResource ChipColor}, ConverterParameter=text}" />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Plant elements" FontSize="22" FontAttributes="Bold" />
                    <Label x:Name="connectionLabel"
                           FontSize="10.5"
                           TextColor="{StaticResource MutedColor}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button x:Name="refreshButton"
                        Grid.Column="1"
                        Text="Refresh"
                        Style="{StaticResource CompactButton}"
                        Clicked="OnRefreshClicked"
                        VerticalOptions="Center" />
                <Button x:Name="syncButton"
                        Grid.Column="2"
                        Text="Sync now"
                        Style="{StaticResource CompactButton}"
                        Clicked="OnSyncNowClicked"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Border Grid.Column="0" Style="{StaticResource InputBorder}"
                        WidthRequest="152" VerticalOptions="Center">
                    <Grid>
                        <Picker x:Name="bridgePicker"
                                Title="Bridge"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnBridgePicked" />
                        <Label Text="▾"
                               FontSize="12"
                               TextColor="{StaticResource MutedColor}"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"
                               InputTransparent="True" />
                    </Grid>
                </Border>
                <views:SyncBadgeView x:Name="syncBadge" Grid.Column="2" VerticalOptions="Center">
                    <views:SyncBadgeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSyncTapped" />
                    </views:SyncBadgeView.GestureRecognizers>
                </views:SyncBadgeView>
                <views:SyncBadgeView x:Name="latencyBadge"
                                     Grid.Column="3"
                                     Uppercase="False"
                                     Hint=""
                                     VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource SubtleBorder}">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="summaryLabel" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="sourceLabel" FontFamily="monospace" FontSize="10"
                           TextColor="{StaticResource MutedColor}" />
                    <Label x:Name="filterLabel"
                           FontSize="10.5"
                           TextColor="{StaticResource MutedColor}"
                           IsVisible="false" />
                </VerticalStackLayout>
            </Border>

            <SearchBar x:Name="searchBar"
                       Placeholder="Search element, tag or block"
                       TextChanged="OnSearchChanged" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="kindChips" Spacing="6"
                                       BindableLayout.ItemTemplate="{StaticResource FilterChip}" />
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView x:Name="refreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="elementsView" IsGrouped="True" SelectionMode="Single"
                            SelectionChanged="OnElementSelected">
                <CollectionView.EmptyView>
                    <Label x:Name="emptyLabel" TextColor="{StaticResource MutedColor}" Margin="8" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,6" Style="{StaticResource SubtleBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Chevron}" FontSize="12"
                                       VerticalOptions="Center" TextColor="{StaticResource MutedColor}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding KindLabel}" FontSize="9"
                                               TextColor="{StaticResource MutedColor}" />
                                        <Label Text="{Binding Area}" FontSize="9"
                                               TextColor="{StaticResource MutedColor}"
                                               IsVisible="{Binding HasArea}" />
                                        <Label Text="{Binding GroupLabel}" FontSize="9"
                                               TextColor="{StaticResource MutedColor}"
                                               IsVisible="{Binding HasGroup}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Summary}" FontSize="10.5"
                                       VerticalOptions="Center" TextColor="{StaticResource MutedColor}" />
                                <Label Grid.Column="3" Text="{Binding StateLabel}" FontSize="10"
                                       FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*">
                            <views:DepthGuideView Grid.Column="0" WidthRequest="{Binding IndentWidth}"
                                                  Depth="{Binding Depth}" GuideColor="{StaticResource BorderColor}"
                                                  VerticalOptions="Fill" />
                            <Border Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource ListCardBorder}">
                                <Grid ColumnDefinitions="26,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Mark}" FontSize="16"
                                           FontAttributes="Bold" VerticalOptions="Center"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Text}" FontSize="13" FontAttributes="Bold"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource PillBorder}" VerticalOptions="Center">
                                            <Label Text="{Binding KindLabel}" FontSize="9" FontAttributes="Bold"
                                                   FontFamily="monospace"
                                                   TextColor="{StaticResource MutedColor}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="0"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding ActualText}" FontSize="16" FontFamily="monospace"
                                               FontAttributes="Bold" HorizontalTextAlignment="End"
                                               TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                        <Label Text="{Binding ValueText}" FontSize="8.5" FontFamily="monospace"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource MutedColor}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StepLabel}"
                                           FontSize="10" TextColor="{StaticResource MutedColor}" />
                                    <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TagLabel}"
                                           FontFamily="monospace" FontSize="9.5"
                                           TextColor="{StaticResource MutedColor}"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ShouldLine}"
                                           IsVisible="{Binding ShowShould}" FontFamily="monospace" FontSize="10.5"
                                           TextColor="{Binding ShouldKey, Converter={StaticResource StateColor}}" />
                                    <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ProgressText}"
                                           IsVisible="{Binding ShowProgress}" FontSize="10.5"
                                           TextColor="{StaticResource WarnColor}" />
                                    <Label Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NextStepText}"
                                           IsVisible="{Binding ShowNextStep}" FontSize="10.5"
                                           TextColor="{StaticResource WarnColor}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
