<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:OpcBridge.Mobile"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             xmlns:core="clr-namespace:OpcBridge.Mobile.Core;assembly=OpcBridge.Mobile.Core"
             x:Class="OpcBridge.Mobile.Views.ElementsPage"
             Title="Elements"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{theme:ThemeColor PageBg}">
    <ContentPage.Resources>
        <!-- V2 segmented kind filter: one rail, the chosen segment raised on its own surface. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{theme:ThemeColor MutedColor}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="MinimumHeightRequest" Value="30" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{theme:ThemeColor SurfaceAltColor}" />
                    <Setter Property="TextColor" Value="{theme:ThemeColor TextColor}" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16,4,16,0" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,2,0,4">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Plant elements" FontSize="22" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <BoxView x:Name="connectionDot"
                                 WidthRequest="6"
                                 HeightRequest="6"
                                 CornerRadius="3"
                                 Color="{theme:ThemeColor MutedColor}"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="connectionLabel"
                               FontSize="10.5"
                               TextColor="{theme:ThemeColor MutedColor}"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Border x:Name="refreshButton"
                            Style="{StaticResource IconActionBorder}"
                            SemanticProperties.Description="Refresh elements">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{theme:ThemeIcon icon_refresh}" WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="syncButton"
                            Style="{StaticResource IconActionBorder}"
                            SemanticProperties.Description="Sync now">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSyncNowClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{theme:ThemeIcon icon_cloud_upload}" WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <BoxView x:Name="sourceDot"
                             WidthRequest="6"
                             HeightRequest="6"
                             CornerRadius="3"
                             Color="{theme:ThemeColor MutedColor}"
                             VerticalOptions="Center" />
                    <Label x:Name="sourceLabel"
                           FontFamily="monospace"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="{theme:ThemeColor MutedColor}"
                           TextTransform="Uppercase"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Grid.Column="2"
                       x:Name="summaryLabel"
                       FontSize="9.5"
                       TextColor="{theme:ThemeColor MutedColor}"
                       VerticalOptions="Center" />
                <Label Grid.Column="3"
                       Text="·"
                       FontSize="9"
                       TextColor="{theme:ThemeColor MutedColor}"
                       VerticalOptions="Center" />
                <views:SyncBadgeView x:Name="latencyBadge"
                                     Grid.Column="4"
                                     Uppercase="False"
                                     TextSize="9.5"
                                     Hint=""
                                     VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource SearchBorder}">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="{theme:ThemeIcon icon_search}"
                           WidthRequest="16"
                           HeightRequest="16"
                           Margin="12,0,9,0"
                           VerticalOptions="Center" />
                    <Entry x:Name="searchEntry"
                           Grid.Column="1"
                           Margin="0,0,12,0"
                           BackgroundColor="Transparent"
                           Placeholder="Search element, tag or block"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </Border>

            <Border BackgroundColor="{theme:ThemeColor SurfaceColor}"
                    Stroke="{theme:ThemeColor BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 11"
                    Padding="3"
                    HeightRequest="36">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                    <Button x:Name="kindAllButton" Grid.Column="0" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindInterlockButton" Grid.Column="1" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindPermissiveButton" Grid.Column="2" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                    <Button x:Name="kindSequenceButton" Grid.Column="3" Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}" Clicked="OnFilterChipClicked" />
                </Grid>
            </Border>

            <Label x:Name="filterLabel"
                   FontSize="10.5"
                   TextColor="{theme:ThemeColor MutedColor}"
                   IsVisible="false" />
        </VerticalStackLayout>

        <RefreshView x:Name="refreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="elementsView" IsGrouped="True" SelectionMode="Single"
                            SelectionChanged="OnElementSelected">
                <CollectionView.EmptyView>
                    <Label x:Name="emptyLabel" TextColor="{theme:ThemeColor MutedColor}" Margin="8" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="core:ElementBlockGroupViewModel">
                        <Border Margin="0,0,0,4" Style="{StaticResource ElementsGroupCardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
                                    <Label Text="{Binding Chevron}" FontSize="11"
                                           VerticalOptions="Center" TextColor="{theme:ThemeColor MutedColor}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                                           MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource ElementBadgeBorder}" VerticalOptions="Center">
                                        <Label Text="{Binding KindLabel}" FontSize="8.5" FontAttributes="Bold"
                                               FontFamily="monospace"
                                               TextColor="{theme:ThemeColor MutedColor}" />
                                    </Border>
                                    <Label Grid.Column="4" Text="{Binding StateLabel}" FontSize="9.5"
                                           FontAttributes="Bold" VerticalOptions="Center"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                </Grid>
                                <Grid ColumnDefinitions="17,*,Auto" ColumnSpacing="8">
                                    <BoxView WidthRequest="17" HeightRequest="1" />
                                    <Label Grid.Column="1" Text="{Binding Meta}" FontSize="9.5"
                                           IsVisible="{Binding HasMeta}"
                                           TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Summary}" FontSize="9.5"
                                           TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="core:LogicElementRowViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <views:DepthGuideView Grid.Column="0" WidthRequest="{Binding IndentWidth}"
                                                  Depth="{Binding Depth}" GuideColor="{theme:ThemeColor BorderColor}"
                                                  IsVisible="{Binding HasDepth}" VerticalOptions="Fill" />
                            <Border Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource ElementCardBorder}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6" RowSpacing="3">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Text}" FontSize="13" FontAttributes="Bold"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource ElementBadgeBorder}" VerticalOptions="Center"
                                                BackgroundColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=bg}"
                                                Stroke="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=border}"
                                                StrokeThickness="1">
                                            <Label Text="{Binding KindLabel}" FontSize="8.5" FontAttributes="Bold"
                                                   FontFamily="monospace"
                                                   TextColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=text}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="0"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding ActualText}" FontSize="16" FontFamily="monospace"
                                               FontAttributes="Bold" HorizontalTextAlignment="End"
                                               TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                        <Label Text="{Binding ValueText}" FontSize="8.5" FontFamily="monospace"
                                               HorizontalTextAlignment="End"
                                               TextColor="{theme:ThemeColor MutedColor}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StepLabel}"
                                           IsVisible="{Binding HasStep}" FontSize="9.5"
                                           TextColor="{theme:ThemeColor MutedColor}" />
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowShould}">
                                        <Label Text="{Binding ShouldLine}" FontFamily="monospace" FontSize="10.5"
                                               TextColor="{Binding ShouldKey, Converter={StaticResource StateColor}}" />
                                        <Border Grid.Column="1" Style="{StaticResource StateChipBorder}"
                                                VerticalOptions="Center" IsVisible="{Binding HasStateWord}">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="STATE" FontFamily="monospace" FontSize="8.5"
                                                       FontAttributes="Bold" CharacterSpacing="0.5"
                                                       TextColor="{theme:ThemeColor MutedColor}" />
                                                <Label Text="{Binding StateWord}" FontSize="9.5" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ProgressText}"
                                           IsVisible="{Binding ShowProgress}" FontSize="10.5"
                                           TextColor="{theme:ThemeColor WarnColor}" />
                                    <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding NextStepText}"
                                           IsVisible="{Binding ShowNextStep}" FontSize="10.5"
                                           TextColor="{theme:ThemeColor WarnColor}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
