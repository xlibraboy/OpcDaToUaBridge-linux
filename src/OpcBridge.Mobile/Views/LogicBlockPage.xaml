<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:OpcBridge.Mobile"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             xmlns:core="clr-namespace:OpcBridge.Mobile.Core;assembly=OpcBridge.Mobile.Core"
             x:Class="OpcBridge.Mobile.Views.LogicBlockPage"
             Title="Logic block"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{theme:ThemeColor PageBg}">
    <ContentPage.Resources>
        <!-- One element of the IEC network: a contact, a gate or a function block. The row indents
             by its depth, with one rail per enclosing level (the web Result board's .rl-kids), so
             the tree reads without extra glyphs. The page keeps the row's view so a checkpoint dot
             can scroll to it and ring it. -->
        <DataTemplate x:Key="ElementRow" x:DataType="core:LogicElementRowViewModel">
            <Grid ColumnDefinitions="Auto,*">
                <views:DepthGuideView Grid.Column="0" WidthRequest="{Binding IndentWidth}"
                                      Depth="{Binding Depth}" GuideColor="{theme:ThemeColor BorderColor}"
                                      IsVisible="{Binding HasDepth}" VerticalOptions="Fill" />
                <Border Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource ElementCardBorder}"
                        Padding="4,9,9,9"
                        Loaded="OnElementRowLoaded" Unloaded="OnElementRowUnloaded">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="3">
                        <!-- The row's left accent repeats the state so the kind chip is not the only cue. -->
                        <Border WidthRequest="3" Margin="0,4" VerticalOptions="Fill"
                                StrokeThickness="0" StrokeShape="RoundRectangle 2"
                                BackgroundColor="{Binding StateKey, Converter={StaticResource StateColor}, ConverterParameter=checkpoint}" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="6" RowSpacing="3">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Text}" FontSize="13" FontAttributes="Bold"
                                       MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <!-- The state rides the kind chip; the ✓/✗ column is gone. -->
                                <Border Style="{StaticResource ElementBadgeBorder}" VerticalOptions="Center"
                                        BackgroundColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=bg}"
                                        Stroke="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=border}"
                                        StrokeThickness="1">
                                    <Label Text="{Binding KindLabel}" FontSize="8.5" FontAttributes="Bold"
                                           FontFamily="monospace"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=text}" />
                                </Border>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4"
                                                   HorizontalOptions="End" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="End">
                                    <Label Text="{Binding ActualText}" FontSize="16" FontFamily="monospace"
                                           FontAttributes="Bold" HorizontalTextAlignment="End"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                    <Label Text="{Binding ValueText}" FontSize="8.5" FontFamily="monospace"
                                           HorizontalTextAlignment="End" TextColor="{theme:ThemeColor MutedColor}" />
                                </VerticalStackLayout>
                                <!-- The web Result row's tag door: the icon alone, no tag name in the row. -->
                                <Border WidthRequest="24" HeightRequest="24"
                                        BackgroundColor="Transparent" StrokeThickness="0"
                                        IsVisible="{Binding HasTagReference}"
                                        SemanticProperties.Description="Tag details"
                                        SemanticProperties.Hint="Open the tag source and readers">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTagTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{theme:ThemeIcon icon_tag}" WidthRequest="14" HeightRequest="14"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            <!-- Should vs actual stays the source of truth; the operator's word sits beside it. -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowShould}">
                                <Label Text="{Binding ShouldLine}" FontFamily="monospace" FontSize="10.5"
                                       TextColor="{Binding ShouldKey, Converter={StaticResource StateColor}}" />
                                <Border Grid.Column="1" Style="{StaticResource StateChipBorder}"
                                        VerticalOptions="Center" IsVisible="{Binding HasStateWord}">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="STATE" FontFamily="monospace" FontSize="8.5" FontAttributes="Bold"
                                               CharacterSpacing="0.5" TextColor="{theme:ThemeColor MutedColor}" />
                                        <Label Text="{Binding StateWord}" FontSize="9.5" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ProgressText}"
                                   IsVisible="{Binding ShowProgress}" FontSize="10.5"
                                   TextColor="{theme:ThemeColor WarnColor}" />
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding NextStepText}"
                                   IsVisible="{Binding ShowNextStep}" FontSize="10.5"
                                   TextColor="{theme:ThemeColor WarnColor}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- One block behind a tag: its name and state, what it is, and the lines that use it. -->
        <DataTemplate x:Key="TagUseCard" x:DataType="core:LogicTagUseViewModel">
            <Border Style="{StaticResource SubtleBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTagUseTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="1" Text="{Binding StateLabel}" FontSize="10" FontAttributes="Bold"
                               TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                    </Grid>
                    <Label Text="{Binding Meta}" FontSize="10" TextColor="{theme:ThemeColor MutedColor}" />
                    <VerticalStackLayout Spacing="1" BindableLayout.ItemsSource="{Binding Lines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding}" FontSize="11" LineBreakMode="WordWrap" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- One ordered step of a sequence: its own heading and its element rows. Steps are the
             page's virtualized items, so a long sequence builds only the steps on screen. -->
        <DataTemplate x:Key="StepRow" x:DataType="core:LogicStepRowViewModel">
            <Border Style="{StaticResource SubtleBorder}" Margin="0,0,0,8">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding StateLabel}"
                               TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                    </Grid>
                    <Label Text="{Binding Reason}" FontSize="11"
                           TextColor="{theme:ThemeColor WarnColor}" />
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Elements}"
                                         BindableLayout.ItemTemplate="{StaticResource ElementRow}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- One inspector row: a quiet label/value pair, the LIVE raw + STATE chip, or a warning. -->
        <DataTemplate x:Key="TagPairRow" x:DataType="core:LogicTagRowViewModel">
            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsPair}">
                    <Label Text="{Binding Label}" Style="{StaticResource UppercaseLabel}"
                           TextTransform="Uppercase" VerticalOptions="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8"
                          IsVisible="{Binding IsLive}">
                        <Label Text="{Binding RawValue}" FontFamily="monospace" FontSize="16"
                               FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource StateChipBorder}"
                                VerticalOptions="Center" IsVisible="{Binding ShowStateWord}">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="STATE" FontFamily="monospace" FontSize="8.5"
                                       FontAttributes="Bold" CharacterSpacing="0.5"
                                       TextColor="{theme:ThemeColor MutedColor}" />
                                <Label Text="{Binding StateWord}" FontSize="9.5" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Label Grid.Column="1" Text="{Binding Value}" FontSize="11"
                           LineBreakMode="WordWrap" IsVisible="{Binding ShowPlainValue}" />
                </Grid>
                <Label Text="{Binding Value}" IsVisible="{Binding IsWarning}" FontSize="11"
                       TextColor="{theme:ThemeColor WarnColor}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Padding="16,2,16,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Style="{StaticResource IconActionBorder}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Back to the block list">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="{theme:ThemeIcon icon_chevron_left}" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label x:Name="titleLabel" FontSize="22" FontAttributes="Bold"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Subtitle}" FontSize="10.5"
                           TextColor="{theme:ThemeColor MutedColor}"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        Style="{StaticResource IconActionBorder}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="More options">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMoreClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="{theme:ThemeIcon icon_ellipsis}" WidthRequest="16" HeightRequest="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <CollectionView x:Name="pageScroll"
                            Grid.Row="1"
                            Margin="16,0,16,0"
                            ItemsSource="{Binding Elements}"
                            ItemTemplate="{StaticResource ElementRow}"
                            SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,0,0,12" Spacing="12">
                    <Label x:Name="offlineLabel" FontSize="10.5"
                           TextColor="{theme:ThemeColor WarnColor}" IsVisible="false" />

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label x:Name="stateLabel" FontSize="20" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <!-- The output tag's feedback: whether the live output agrees with the interlock. -->
                                <Border Grid.Column="1" Style="{StaticResource OutputPillBorder}"
                                        IsVisible="{Binding HasOutput}"
                                        Stroke="{Binding OutputKey, Converter={StaticResource StateColor}}"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding OutputText}" FontSize="8.5" FontFamily="monospace"
                                           FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           TextColor="{Binding OutputKey, Converter={StaticResource StateColor}}"
                                           SemanticProperties.Description="{Binding OutputDescription}" />
                                </Border>
                            </Grid>
                            <Label x:Name="blockedLabel" FontSize="11.5" IsVisible="False"
                                   TextColor="{theme:ThemeColor BadColor}" LineBreakMode="WordWrap" />
                            <Label x:Name="descriptionLabel" FontSize="11.5" IsVisible="False"
                                   TextColor="{theme:ThemeColor MutedColor}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding ProgressText}" IsVisible="{Binding ShowProgress}" FontSize="10.5"
                                   TextColor="{theme:ThemeColor WarnColor}" />
                            <BoxView HeightRequest="1" Color="{theme:ThemeColor BorderColor}"
                                     IsVisible="{Binding HasCheckpoints}" />

                            <!-- The header keeps the name, count, Usage and expand on one line;
                                 the checks get their own full-width row so a longer network does not
                                 stack in the middle of the header. A parent is a 12px hollow ring, a
                                 leaf a filled 8px dot; the name lives in the accessible label. -->
                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding HasCheckpoints}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                    <Label Text="CHECKPOINTS" Style="{StaticResource UppercaseLabel}"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1" VerticalOptions="Center"
                                            BackgroundColor="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=bg}"
                                            Stroke="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=border}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="5,1">
                                        <Label Text="{Binding CheckpointSummary}" FontFamily="monospace"
                                               FontSize="9.5" FontAttributes="Bold"
                                               TextColor="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=text}"
                                               SemanticProperties.Description="{Binding CheckpointSummaryDescription}" />
                                    </Border>

                                    <!-- Usage is a second, remembered toggle, shared with the fullsheet. -->
                                    <Border Grid.Column="3" HeightRequest="24" Padding="6,0" VerticalOptions="Center"
                                            BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                            Stroke="{theme:ThemeColor BorderColor}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            SemanticProperties.Description="Checkpoint usage dots">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCheckpointUsageTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Image Source="{theme:ThemeIcon icon_activity}" WidthRequest="10" HeightRequest="10"
                                                   VerticalOptions="Center" />
                                            <Label Text="Usage" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Grid WidthRequest="22" HeightRequest="12" VerticalOptions="Center">
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="{theme:ThemeColor BorderColor}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsUsageOn}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{theme:ThemeColor GoodColor}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <Border WidthRequest="8" HeightRequest="8" Margin="2,0,0,0"
                                                        HorizontalOptions="Start" VerticalOptions="Center"
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                                        BackgroundColor="{theme:ThemeColor SurfaceColor}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsUsageOn}" Value="True">
                                                            <Setter Property="HorizontalOptions" Value="End" />
                                                            <Setter Property="Margin" Value="0,0,2,0" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </Grid>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border Grid.Column="4" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                                            BackgroundColor="{theme:ThemeColor SurfaceAltColor}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            SemanticProperties.Description="Open all checkpoints">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCheckpointSheetExpandTapped" />
                                        </Border.GestureRecognizers>
                                        <Image Source="{theme:ThemeIcon icon_expand}" WidthRequest="12" HeightRequest="12"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                            JustifyContent="Start" HorizontalOptions="Fill"
                                            BindableLayout.ItemsSource="{Binding Checkpoints}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="core:LogicCheckpointViewModel">
                                            <!-- The state dot keeps its size and colour; the 4px usage
                                                 dot shares one baseline under every parent ring / leaf dot. -->
                                            <Grid WidthRequest="12" HeightRequest="22" Margin="0,0,5,0"
                                                  SemanticProperties.Description="{Binding Description}"
                                                  SemanticProperties.Hint="{Binding Hint}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCheckpointTapped" CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Border WidthRequest="8" HeightRequest="8" Margin="0,2,0,0"
                                                        HorizontalOptions="Center" VerticalOptions="Start"
                                                        StrokeThickness="1"
                                                        Stroke="{Binding StateKey, Converter={StaticResource StateColor}, ConverterParameter=checkpoint}"
                                                        StrokeShape="RoundRectangle 4"
                                                        BackgroundColor="{Binding StateKey, Converter={StaticResource StateColor}, ConverterParameter=checkpoint}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsParent}" Value="True">
                                                            <Setter Property="WidthRequest" Value="12" />
                                                            <Setter Property="HeightRequest" Value="12" />
                                                            <Setter Property="Margin" Value="0" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
                                                            <Setter Property="BackgroundColor" Value="{theme:ThemeColor SurfaceColor}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <Border WidthRequest="4" HeightRequest="4"
                                                        HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,2"
                                                        IsVisible="{Binding ShowUsageDot}"
                                                        BackgroundColor="{Binding UsageKey, Converter={StaticResource UsageColor}, ConverterParameter=fill}"
                                                        Stroke="{Binding UsageKey, Converter={StaticResource UsageColor}, ConverterParameter=stroke}"
                                                        StrokeThickness="{Binding UsageKey, Converter={StaticResource UsageColor}, ConverterParameter=thickness}"
                                                        StrokeShape="RoundRectangle 2" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="messageLabel" Text="" FontSize="12"
                           TextColor="{theme:ThemeColor WarnColor}" LineBreakMode="WordWrap">
                        <Label.Triggers>
                            <Trigger TargetType="Label" Property="Text" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </Trigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="NETWORK" Style="{StaticResource UppercaseLabel}" IsVisible="{Binding ShowNetwork}" />
                    <Label Text="STEPS" Style="{StaticResource UppercaseLabel}" IsVisible="{Binding IsSequence}" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12,0,28" Spacing="12">

                    <Label Text="ACTIONS" Style="{StaticResource UppercaseLabel}"
                           IsVisible="{Binding ShowActions}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Actions}"
                                         IsVisible="{Binding ShowActions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Label}"
                                        Style="{StaticResource SecondaryButton}"
                                        HeightRequest="42"
                                        FontSize="12.5"
                                        Clicked="OnActionClicked" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="NOTES" Style="{StaticResource UppercaseLabel}" />
                    <Label FontSize="10.5"
                           TextColor="{theme:ThemeColor MutedColor}"
                           IsVisible="{Binding IsReadOnly}"
                           Text="Offline view — notes stay readable; sign in when the bridge is back to add one."
                           LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding ShowNoteComposer}">
                        <Border Style="{StaticResource SearchBorder}">
                            <Entry x:Name="noteEntry"
                                   Margin="12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Add a note for the next shift…" />
                        </Border>
                        <Border Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{theme:ThemeColor GoodColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11"
                                SemanticProperties.Description="Add note">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddNoteClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="{theme:ThemeIcon icon_send}"
                                   WidthRequest="17"
                                   HeightRequest="17"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Notes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleBorder}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Text}" FontSize="12" />
                                        <Label Text="{Binding Meta}" FontSize="9.5"
                                               TextColor="{theme:ThemeColor MutedColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- The tag inspector: the web Result tab's Source / Used by views, on the sheet's own tabs. -->
        <Grid IsVisible="{Binding IsTagPanelOpen}">
            <BoxView Color="{theme:ThemeColor ScrimColor}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTagPanelScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Margin="10,60,10,10" Padding="14"
                    Style="{StaticResource CardBorder}"
                    BindingContext="{Binding SelectedTag}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                      x:DataType="core:LogicTagInspectorViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Image Source="{theme:ThemeIcon icon_tag}" WidthRequest="14" HeightRequest="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                        <Border Grid.Column="2"
                                WidthRequest="28" HeightRequest="28"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                SemanticProperties.Description="Close tag details">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTagPanelCloseClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="{theme:ThemeIcon icon_x}" WidthRequest="14" HeightRequest="14"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Label Grid.Row="1" Text="{Binding Subtitle}" FontSize="11"
                           TextColor="{theme:ThemeColor MutedColor}" />
                    <HorizontalStackLayout Grid.Row="2" Spacing="6">
                        <Border HeightRequest="26" Padding="12,0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{theme:ThemeColor SurfaceAltColor}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSourceView}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{theme:ThemeColor TextColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTagSourceTabTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Source" FontSize="10.5" FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSourceView}" Value="True">
                                        <Setter Property="TextColor" Value="{theme:ThemeColor PageBg}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border HeightRequest="26" Padding="12,0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{theme:ThemeColor SurfaceAltColor}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUsageView}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{theme:ThemeColor TextColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTagUsageTabTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding UsageTabLabel}" FontSize="10.5" FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsUsageView}" Value="True">
                                        <Setter Property="TextColor" Value="{theme:ThemeColor PageBg}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </HorizontalStackLayout>
                    <ScrollView Grid.Row="3">
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSourceView}">
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding IdentityRows}"
                                                     BindableLayout.ItemTemplate="{StaticResource TagPairRow}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="DRIVEN BY" Style="{StaticResource UppercaseLabel}" />
                                    <BoxView Grid.Column="1" HeightRequest="1"
                                             Color="{theme:ThemeColor BorderColor}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding DriverSummary}" FontSize="11"
                                       TextColor="{theme:ThemeColor MutedColor}" />
                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Drivers}"
                                                     BindableLayout.ItemTemplate="{StaticResource TagUseCard}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="MAPPED SOURCE" Style="{StaticResource UppercaseLabel}" />
                                    <BoxView Grid.Column="1" HeightRequest="1"
                                             Color="{theme:ThemeColor BorderColor}" VerticalOptions="Center" />
                                </Grid>
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding MappedRows}"
                                                     BindableLayout.ItemTemplate="{StaticResource TagPairRow}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsUsageView}">
                                <Label Text="{Binding UsageSummary}" FontSize="11"
                                       TextColor="{theme:ThemeColor MutedColor}" />
                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Readers}"
                                                     BindableLayout.ItemTemplate="{StaticResource TagUseCard}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- The fullsheet: the complete checkpoint sequence, type filters, activation counts and
             last-active times. It fills the page above the tab bar and follows the app theme. -->
        <Grid IsVisible="{Binding IsCheckpointSheetOpen}">
            <BoxView Color="{theme:ThemeColor ScrimColor}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCheckpointSheetScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Margin="10,8,10,6" Padding="14" Style="{StaticResource CardBorder}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Checkpoints" FontSize="19" FontAttributes="Bold" />
                            <Label Text="{Binding CheckpointSheetSubtitle}" FontSize="10.5"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" VerticalOptions="Center"
                                BackgroundColor="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=bg}"
                                Stroke="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=border}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="5,1">
                            <Label Text="{Binding CheckpointSummary}" FontFamily="monospace"
                                   FontSize="9.5" FontAttributes="Bold"
                                   TextColor="{Binding CheckpointSummaryKey, Converter={StaticResource StateTint}, ConverterParameter=text}" />
                        </Border>
                        <Border Grid.Column="2" WidthRequest="28" HeightRequest="28"
                                BackgroundColor="{theme:ThemeColor SurfaceAltColor}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                SemanticProperties.Description="Close checkpoints">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckpointSheetCloseClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="{theme:ThemeIcon icon_x}" WidthRequest="14" HeightRequest="14"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <FlexLayout Grid.Row="1" Wrap="Wrap" Direction="Row" AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding CheckpointFilters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="core:LogicCheckpointFilterViewModel">
                                <Border HeightRequest="26" Padding="8,0" Margin="0,0,6,4"
                                        BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                        Stroke="{theme:ThemeColor BorderColor}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{theme:ThemeColor TextColor}" />
                                            <Setter Property="Stroke" Value="{theme:ThemeColor TextColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCheckpointFilterTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Label}" FontSize="9.5" FontAttributes="Bold"
                                               TextColor="{theme:ThemeColor MutedColor}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="TextColor" Value="{theme:ThemeColor PageBg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Count}" FontSize="8.5" FontFamily="monospace"
                                               TextColor="{theme:ThemeColor MutedColor}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="TextColor" Value="{theme:ThemeColor PageBg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="sequence · start → end" FontSize="9" FontFamily="monospace"
                               TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                        <Border Grid.Column="1" HeightRequest="24" Padding="6,0" VerticalOptions="Center"
                                BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                Stroke="{theme:ThemeColor BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                SemanticProperties.Description="Checkpoint usage dots">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckpointUsageTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Image Source="{theme:ThemeIcon icon_activity}" WidthRequest="10" HeightRequest="10"
                                       VerticalOptions="Center" />
                                <Label Text="Usage" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                <Grid WidthRequest="22" HeightRequest="12" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{theme:ThemeColor BorderColor}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsUsageOn}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{theme:ThemeColor GoodColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Border WidthRequest="8" HeightRequest="8" Margin="2,0,0,0"
                                            HorizontalOptions="Start" VerticalOptions="Center"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            BackgroundColor="{theme:ThemeColor SurfaceColor}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsUsageOn}" Value="True">
                                                <Setter Property="HorizontalOptions" Value="End" />
                                                <Setter Property="Margin" Value="0,0,2,0" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Grid>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView Grid.Row="3" HeightRequest="1" Color="{theme:ThemeColor BorderColor}" />

                    <CollectionView Grid.Row="4" ItemsSource="{Binding CheckpointSheetRows}"
                                    SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.EmptyView>
                            <Label Text="No checkpoints match this filter." FontSize="11"
                                   TextColor="{theme:ThemeColor MutedColor}" Margin="4,20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:LogicCheckpointViewModel">
                                <Border Margin="0,0,0,6" Padding="10"
                                        BackgroundColor="{theme:ThemeColor SurfaceColor}"
                                        Stroke="{theme:ThemeColor BorderColor}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        SemanticProperties.Description="{Binding Description}"
                                        SemanticProperties.Hint="{Binding Hint}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsParent}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{theme:ThemeColor SurfaceAltColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCheckpointSheetRowTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Sequence}" FontSize="9" FontFamily="monospace"
                                               TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Start" />
                                        <Border Grid.Column="1" WidthRequest="8" HeightRequest="8" Margin="0,3,0,0"
                                                HorizontalOptions="Center" VerticalOptions="Start"
                                                StrokeThickness="1"
                                                Stroke="{Binding StateKey, Converter={StaticResource StateColor}, ConverterParameter=checkpoint}"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{Binding StateKey, Converter={StaticResource StateColor}, ConverterParameter=checkpoint}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsParent}" Value="True">
                                                    <Setter Property="WidthRequest" Value="12" />
                                                    <Setter Property="HeightRequest" Value="12" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="StrokeShape" Value="RoundRectangle 6" />
                                                    <Setter Property="BackgroundColor" Value="{theme:ThemeColor SurfaceColor}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="12.5" FontAttributes="Bold"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Border HeightRequest="15" Padding="4,0" IsVisible="{Binding ShowLatest}"
                                                        BackgroundColor="{theme:ThemeColor SurfaceColor}"
                                                        Stroke="{theme:ThemeColor UsageWarmColor}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 3">
                                                    <Label Text="LATEST" FontSize="7.5" FontAttributes="Bold"
                                                           CharacterSpacing="0.4"
                                                           TextColor="{theme:ThemeColor UsageHotColor}" />
                                                </Border>
                                                <Border HeightRequest="15" Padding="4,0" IsVisible="{Binding ShowNever}"
                                                        BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                                        Stroke="{theme:ThemeColor BorderColor}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 3">
                                                    <Label Text="NEVER" FontSize="7.5" FontAttributes="Bold"
                                                           CharacterSpacing="0.4"
                                                           TextColor="{theme:ThemeColor MutedColor}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding SourceLabel}" FontSize="9.5"
                                                   TextColor="{theme:ThemeColor MutedColor}"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="4" IsVisible="{Binding ShowUsageLine}">
                                                <Image Source="{theme:ThemeIcon icon_history}" WidthRequest="9" HeightRequest="9"
                                                       IsVisible="{Binding IsSourceLess}" VerticalOptions="Center" />
                                                <Label Text="{Binding UsageCountText}" FontSize="10" FontFamily="monospace"
                                                       FontAttributes="Bold" VerticalOptions="Center"
                                                       TextColor="{Binding UsageKey, Converter={StaticResource UsageColor}, ConverterParameter=text}" />
                                                <Label Text="{Binding UsageLastText}" FontSize="9.5"
                                                       TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="3" VerticalOptions="Start" Padding="6,2"
                                                BackgroundColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=bg}"
                                                Stroke="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=border}"
                                                StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                            <Label Text="{Binding ChipWord}" FontSize="8" FontAttributes="Bold"
                                                   CharacterSpacing="0.4"
                                                   TextColor="{Binding StateKey, Converter={StaticResource StateTint}, ConverterParameter=text}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Grid.Row="5" Style="{StaticResource SubtleBorder}" Padding="10"
                            IsVisible="{Binding IsUsageOn}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="USAGE · LAST 7 DAYS" Style="{StaticResource UppercaseLabel}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCheckpointSheetTop}">
                                <Label Text="{Binding CheckpointSheetTopText}" FontSize="9.5" />
                                <Label Grid.Column="1" Text="{Binding CheckpointSheetTopCount}"
                                       FontSize="9.5" FontFamily="monospace" FontAttributes="Bold"
                                       TextColor="{Binding CheckpointSheetTopKey, Converter={StaticResource UsageColor}, ConverterParameter=text}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCheckpointSheetNoSource}">
                                <Label Text="{Binding CheckpointSheetNoSourceText}" FontSize="9"
                                       TextColor="{theme:ThemeColor MutedColor}" />
                                <Label Grid.Column="1" Text="{Binding CheckpointSheetNoSourceLast}"
                                       FontSize="9" FontFamily="monospace"
                                       TextColor="{theme:ThemeColor MutedColor}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="4">
                                    <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{theme:ThemeColor UsageHotColor}" />
                                    <Label Text="Frequent" FontSize="8" TextColor="{theme:ThemeColor MutedColor}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{theme:ThemeColor UsageWarmColor}" />
                                    <Label Text="Regular" FontSize="8" TextColor="{theme:ThemeColor MutedColor}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{theme:ThemeColor UsageCoolColor}" />
                                    <Label Text="Rare" FontSize="8" TextColor="{theme:ThemeColor MutedColor}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Border WidthRequest="6" HeightRequest="6" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 3"
                                            Stroke="{theme:ThemeColor UsageNoneColor}"
                                            BackgroundColor="{theme:ThemeColor SurfaceColor}" />
                                    <Label Text="No source" FontSize="8" TextColor="{theme:ThemeColor MutedColor}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="State is the evaluation · usage is blue" FontSize="8.5"
                               TextColor="{theme:ThemeColor MutedColor}" />
                        <Label Grid.Column="1" Text="tap a row to jump · 7 days" FontSize="8.5"
                               FontFamily="monospace" TextColor="{theme:ThemeColor MutedColor}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
