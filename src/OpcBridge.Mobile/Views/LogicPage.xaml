<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             x:Class="OpcBridge.Mobile.Views.LogicPage"
             Title="Logic"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">
    <ContentPage.Resources>
        <!-- One search/filter chip: filled and dark-texted while selected, dark with muted
             text otherwise, so the choice reads without relying on colour alone. -->
        <DataTemplate x:Key="FilterChip">
            <Button Text="{Binding Label}" Clicked="OnFilterChipClicked" FontSize="10" Padding="10,4" CornerRadius="9"
                    HeightRequest="26" MinimumHeightRequest="26"
                    BackgroundColor="{Binding IsSelected, Converter={StaticResource ChipColor}}"
                    TextColor="{Binding IsSelected, Converter={StaticResource ChipColor}, ConverterParameter=text}" />
        </DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Plant logic" FontSize="22" FontAttributes="Bold" />
                    <Label x:Name="connectionLabel"
                           FontSize="10.5"
                           TextColor="{StaticResource MutedColor}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button x:Name="refreshButton"
                        Grid.Column="1"
                        Text="Refresh"
                        Style="{StaticResource CompactButton}"
                        Clicked="OnRefreshClicked"
                        VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="Settings"
                        Style="{StaticResource CompactButton}"
                        Clicked="OnSettingsClicked"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Border Grid.Column="0" Style="{StaticResource InputBorder}"
                        WidthRequest="152" VerticalOptions="Center">
                    <Grid>
                        <Picker x:Name="bridgePicker"
                                Title="Bridge"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnBridgePicked" />
                        <Label Text="▾"
                               FontSize="12"
                               TextColor="{StaticResource MutedColor}"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"
                               InputTransparent="True" />
                    </Grid>
                </Border>
                <views:SyncBadgeView x:Name="syncBadge" Grid.Column="2" VerticalOptions="Center">
                    <views:SyncBadgeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSyncTapped" />
                    </views:SyncBadgeView.GestureRecognizers>
                </views:SyncBadgeView>
                <views:SyncBadgeView x:Name="latencyBadge"
                                     Grid.Column="3"
                                     Uppercase="False"
                                     Hint=""
                                     VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource SubtleBorder}">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="summaryLabel" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="filterLabel"
                           FontSize="10.5"
                           TextColor="{StaticResource MutedColor}"
                           IsVisible="false" />
                    <Label x:Name="offlineLabel"
                           FontSize="10.5"
                           TextColor="{StaticResource WarnColor}"
                           IsVisible="false" />
                </VerticalStackLayout>
            </Border>

            <SearchBar x:Name="searchBar"
                       Placeholder="Search name, description or tags"
                       TextChanged="OnSearchChanged" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout x:Name="stateChips" Spacing="6"
                                           BindableLayout.ItemTemplate="{StaticResource FilterChip}" />
                    <BoxView x:Name="chipDivider" WidthRequest="1" Color="{StaticResource BorderColor}"
                             Margin="2,3" IsVisible="false" />
                    <HorizontalStackLayout x:Name="tagChips" Spacing="6"
                                           BindableLayout.ItemTemplate="{StaticResource FilterChip}" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView x:Name="refreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="blocksView" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnBlockSelected">
                <CollectionView.EmptyView>
                    <Label x:Name="emptyLabel" TextColor="{StaticResource MutedColor}" Margin="8" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,6" Style="{StaticResource SubtleBorder}"
                                IsVisible="{Binding ShowHeader}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Chevron}" FontSize="12" VerticalOptions="Center"
                                       TextColor="{StaticResource MutedColor}" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Summary}" FontSize="10.5"
                                       VerticalOptions="Center" TextColor="{StaticResource MutedColor}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Style="{StaticResource ListCardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <BoxView WidthRequest="3" HeightRequest="30" CornerRadius="2"
                                             VerticalOptions="Center"
                                             Color="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource PillBorder}" VerticalOptions="Center">
                                            <Label Text="{Binding KindLabel}" FontSize="9" FontAttributes="Bold"
                                                   TextColor="{StaticResource MutedColor}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding StateLabel}" FontAttributes="Bold"
                                           FontSize="10" CharacterSpacing="0.6" VerticalOptions="Center"
                                           TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                    <!-- Each row folds on its own, to its name and state; the fold is
                                         remembered while the app is open. -->
                                    <Button Grid.Column="3" Text="{Binding FoldChevron}"
                                            Command="{Binding ToggleFoldCommand}"
                                            Style="{StaticResource GhostButton}"
                                            SemanticProperties.Description="{Binding FoldLabel}" />
                                </Grid>
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowDetails}">
                                    <Label Text="{Binding Area}" FontSize="9.5"
                                           TextColor="{StaticResource MutedColor}"
                                           IsVisible="{Binding HasArea}" />
                                    <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                                BindableLayout.ItemsSource="{Binding Tags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,2" Style="{StaticResource PillBorder}">
                                                    <Label Text="{Binding}" FontSize="9"
                                                           TextColor="{StaticResource MutedColor}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <Label Text="{Binding Reason}" FontSize="12" />
                                    <Label Text="{Binding ProgressText}" FontSize="10.5"
                                           TextColor="{StaticResource MutedColor}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
