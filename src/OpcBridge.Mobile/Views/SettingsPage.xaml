<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:OpcBridge.Mobile"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             x:Class="OpcBridge.Mobile.Views.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{theme:ThemeColor PageBg}">
    <ContentPage.Resources>
        <!-- The Appearance rail: the chosen segment sits on the raised surface, the others stay
             on the rail, matching the Elements kind filter. -->
        <Style x:Key="ThemeSegmentButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{theme:ThemeColor MutedColor}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="MinimumHeightRequest" Value="30" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="16,4,16,12" Spacing="12">
            <VerticalStackLayout Spacing="3" Padding="0,2,0,4">
                <Label Text="Settings" FontSize="22" FontAttributes="Bold" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <BoxView x:Name="connectionDot"
                             WidthRequest="6"
                             HeightRequest="6"
                             CornerRadius="3"
                             Color="{theme:ThemeColor MutedColor}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="connectionLabel"
                           FontSize="10.5"
                           TextColor="{theme:ThemeColor MutedColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccessPointTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Plant Wi-Fi" Style="{StaticResource SectionTitleLabel}"
                               VerticalOptions="Center" />
                        <Border x:Name="accessPointBadge"
                                Grid.Column="1"
                                Style="{StaticResource MetaBadgeBorder}"
                                VerticalOptions="Center">
                            <Label x:Name="accessPointBadgeLabel" Text="NOT BOUND"
                                   Style="{StaticResource BadgeLabel}"
                                   FontFamily="monospace" FontSize="8"
                                   FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SubtleBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Source="{theme:ThemeIcon icon_wifi}"
                                   WidthRequest="15" HeightRequest="15"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label x:Name="accessPointSsidLabel" Text="Not provisioned"
                                       FontSize="12" FontAttributes="Bold"
                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label x:Name="accessPointBssidLabel" Text="Engineer/Admin setup required"
                                       FontFamily="monospace" FontSize="8.5"
                                       TextColor="{theme:ThemeColor MutedColor}"
                                       MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2"
                                   Source="{theme:ThemeIcon icon_chevron_right}"
                                   WidthRequest="15" HeightRequest="15"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label Text="Live data only works on the bound access point."
                           Style="{StaticResource MetaLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Bridges" Style="{StaticResource SectionTitleLabel}" />
                        <Label x:Name="bridgesCountLabel"
                               Grid.Column="1"
                               Text="0 saved"
                               FontSize="9.5"
                               TextColor="{theme:ThemeColor MutedColor}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Tap a bridge to make it live; one live link at a time."
                           Style="{StaticResource MetaLabel}" />
                    <VerticalStackLayout x:Name="bridgesList" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBridgeTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="13"
                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                            <BoxView Grid.Column="1" WidthRequest="6" HeightRequest="6"
                                                     CornerRadius="3" Color="{theme:ThemeColor MutedColor}"
                                                     VerticalOptions="Center">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Color" Value="{theme:ThemeColor GoodColor}" />
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                            <Label Grid.Column="2" Text="ACTIVE" IsVisible="{Binding IsActive}"
                                                   FontSize="8.5" FontAttributes="Bold"
                                                   TextColor="{theme:ThemeColor GoodColor}"
                                                   HorizontalOptions="Start" VerticalOptions="Center" />
                                            <Border Grid.Column="3"
                                                    Style="{StaticResource SmallActionBorder}"
                                                    SemanticProperties.Description="Remove this bridge">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRemoveBridgeClicked" />
                                                </Border.GestureRecognizers>
                                                <Image Source="{theme:ThemeIcon icon_trash}" WidthRequest="12" HeightRequest="12"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Bridge.Url}" FontFamily="monospace" FontSize="8.5"
                                               TextColor="{theme:ThemeColor MutedColor}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="2.5"
                                                     Color="{Binding SyncKey, Converter={StaticResource StateColor}}"
                                                     VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding StatusText}"
                                                   FontSize="9.5" FontAttributes="Bold"
                                                   TextColor="{Binding SyncKey, Converter={StaticResource StateColor}}"
                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding SyncStamp}"
                                                   FontFamily="monospace" FontSize="8.5" FontAttributes="Bold"
                                                   TextTransform="Uppercase"
                                                   TextColor="{Binding SyncKey, Converter={StaticResource StateColor}}"
                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                   MaximumWidthRequest="130"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="·" FontSize="8.5"
                                                   TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding LatencyValue}"
                                                   FontFamily="monospace" FontSize="8.5" FontAttributes="Bold"
                                                   TextColor="{Binding LatencyKey, Converter={StaticResource StateColor}}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="bridgesEmptyLabel" Text="No bridges saved yet — add one below."
                           FontSize="10.5" TextColor="{theme:ThemeColor MutedColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Add a bridge" Style="{StaticResource SectionTitleLabel}" />
                        <Border Grid.Column="1" Style="{StaticResource MetaBadgeBorder}" VerticalOptions="Center">
                            <Label Text="HOST / IP" Style="{StaticResource BadgeLabel}"
                                   FontFamily="monospace" FontSize="8" FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </Border>
                    </Grid>
                    <Label Text="The phone must be on the bound plant access point."
                           Style="{StaticResource MetaLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_server}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="hostEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="10.3.1.50 or http://10.3.1.50:8080" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_tag}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="nameEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Name (optional, e.g. Line 1)" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="connectButton" Text="Add &amp; Connect"
                                Style="{StaticResource PrimaryButton}" Clicked="OnConnectClicked" />
                        <Button x:Name="cancelConnectButton" Grid.Column="1" Text="Cancel"
                                Style="{StaticResource SecondaryButton}" IsVisible="False"
                                VerticalOptions="Center" Clicked="OnCancelConnectClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <ActivityIndicator x:Name="busyIndicator" WidthRequest="16" HeightRequest="16"
                                           Color="{theme:ThemeColor GoodColor}" IsRunning="False"
                                           IsVisible="False" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="connectionMessageLabel" Text="" FontSize="10"
                               TextColor="{theme:ThemeColor MutedColor}" LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <Trigger TargetType="Label" Property="Text" Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </Trigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Appearance" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource MetaBadgeBorder}" VerticalOptions="Center">
                            <Label Text="DISPLAY" Style="{StaticResource BadgeLabel}"
                                   FontFamily="monospace" FontSize="8" FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </Border>
                    </Grid>
                    <Label Text="Follow the phone, or pin the viewer's surface."
                           Style="{StaticResource MetaLabel}" />
                    <Border BackgroundColor="{theme:ThemeColor SurfaceColor}"
                            Stroke="{theme:ThemeColor BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            Padding="3"
                            HeightRequest="36">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
                            <Button x:Name="themeSystemButton" Grid.Column="0" Text="System"
                                    Style="{StaticResource ThemeSegmentButton}"
                                    CommandParameter="System" Clicked="OnThemeClicked" />
                            <Button x:Name="themeLightButton" Grid.Column="1" Text="Light"
                                    Style="{StaticResource ThemeSegmentButton}"
                                    CommandParameter="Light" Clicked="OnThemeClicked" />
                            <Button x:Name="themeDarkButton" Grid.Column="2" Text="Dark"
                                    Style="{StaticResource ThemeSegmentButton}"
                                    CommandParameter="Dark" Clicked="OnThemeClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Account" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center" />
                        <Image Grid.Column="1" Source="{theme:ThemeIcon icon_lock}"
                               WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Border BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                WidthRequest="32"
                                HeightRequest="32">
                            <Label x:Name="sessionAvatar"
                                   Text="—"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor GoodColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label x:Name="sessionName" FontSize="12" FontAttributes="Bold" />
                            <Label x:Name="sessionLabel" FontSize="9.5"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button x:Name="signOutButton" Text="Sign out"
                            Style="{StaticResource SecondaryButton}" HeightRequest="40"
                            Clicked="OnSignOutClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Sync" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center" />
                        <Border x:Name="syncBadgeBorder"
                                Grid.Column="1"
                                Style="{StaticResource OutputPillBorder}"
                                HeightRequest="20"
                                Padding="7,0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                VerticalOptions="Center">
                            <Label x:Name="syncBadgeLabel" Style="{StaticResource BadgeLabel}"
                                   FontFamily="monospace"
                                   FontSize="8.5"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label Text="Notes and actions taken while the bridge was unreachable wait here until they can be sent. A write that may already have reached the bridge is never replayed automatically."
                           Style="{StaticResource MetaLabel}" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <Label Text="Sync state" FontSize="10"
                               TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" x:Name="syncStateDot"
                                 WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="3" x:Name="syncStateValue" FontSize="10"
                               FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <Label Text="Network latency" FontSize="10"
                               TextColor="{theme:ThemeColor MutedColor}" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" x:Name="latencyDot"
                                 WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="3" x:Name="latencyValue" FontFamily="monospace" FontSize="10"
                               FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Button x:Name="retrySyncButton" Text="Retry now"
                            Style="{StaticResource SecondaryButton}" HeightRequest="40"
                            Clicked="OnRetrySyncClicked" />
                    <VerticalStackLayout x:Name="outboxList" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{theme:ThemeColor SurfaceAltColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding KindLabel}" FontAttributes="Bold" FontSize="12" />
                                            <Border Grid.Column="1" Style="{StaticResource MetaInsetBadgeBorder}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding StateLabel}" Style="{StaticResource BadgeLabel}"
                                                       FontFamily="monospace" FontSize="8.5" FontAttributes="Bold"
                                                       TextColor="{Binding StateKey, Converter={StaticResource StateColor}}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding TargetText}" FontSize="10.5" />
                                        <Label Text="{Binding Detail}" FontSize="9.5"
                                               TextColor="{theme:ThemeColor MutedColor}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding QueuedText, StringFormat='queued {0}'}"
                                               FontFamily="monospace" FontSize="8.5"
                                               TextColor="{theme:ThemeColor MutedColor}" />
                                        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="9"
                                               TextColor="{theme:ThemeColor BadColor}" LineBreakMode="WordWrap" />
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsActionable}">
                                            <Button Text="Retry" Style="{StaticResource TinyButton}"
                                                    Clicked="OnRetryOutboxClicked" />
                                            <Button Text="Discard" Style="{StaticResource TinyButton}"
                                                    Clicked="OnDiscardOutboxClicked" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="outboxEmptyLabel" Text="Nothing queued for the selected bridge."
                           FontSize="10.5" TextColor="{theme:ThemeColor MutedColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="About" Style="{StaticResource SectionTitleLabel}" />
                        <Border Grid.Column="1" Style="{StaticResource MetaBadgeBorder}" VerticalOptions="Center">
                            <Label x:Name="aboutVersionLabel" Style="{StaticResource BadgeLabel}"
                                   FontFamily="monospace" FontSize="8" FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}" />
                        </Border>
                    </Grid>
                    <Label x:Name="aboutTextLabel" FontSize="10.5"
                           TextColor="{theme:ThemeColor MutedColor}" LineBreakMode="WordWrap" />
                    <Label x:Name="aboutFooterLabel" FontSize="9.5"
                           TextColor="{theme:ThemeColor MutedColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
        <views:BottomTabBar Grid.Row="1" ActiveTab="settings" />
    </Grid>
</ContentPage>
