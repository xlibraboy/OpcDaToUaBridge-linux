<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpcBridge.Mobile.Views.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">
            <Label Text="Bridge" FontSize="18" FontAttributes="Bold" />
            <Label Text="Enter the bridge host or IP (the phone must be on the plant network)."
                   FontSize="12" TextColor="{StaticResource MutedColor}" />
            <Entry x:Name="hostEntry" Placeholder="10.3.1.50 or http://10.3.1.50:8080" />
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="connectButton" Text="Scan &amp; Connect" Clicked="OnConnectClicked" />
            </HorizontalStackLayout>
            <Label x:Name="connectionLabel" FontSize="13" TextColor="{StaticResource MutedColor}" />

            <Label Text="Sign in" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="Only needed when the bridge requires a session (Auth enabled without TrustHmi). Actions need the Operator role."
                   FontSize="12" TextColor="{StaticResource MutedColor}" />
            <Entry x:Name="userEntry" Placeholder="Username" />
            <Entry x:Name="passwordEntry" Placeholder="Password" IsPassword="True" />
            <Button x:Name="signInButton" Text="Sign in" Clicked="OnSignInClicked" />
            <Label x:Name="sessionLabel" FontSize="13" TextColor="{StaticResource MutedColor}" />

            <Label Text="About" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label x:Name="aboutLabel" FontSize="13" TextColor="{StaticResource MutedColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
