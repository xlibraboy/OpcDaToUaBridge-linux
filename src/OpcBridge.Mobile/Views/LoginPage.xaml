<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpcBridge.Mobile.Views.LoginPage"
             Title="Sign in"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,20" Spacing="14">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border Style="{StaticResource LogoBorder}">
                    <Label Text="OB"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GoodColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="OpcBridge" FontSize="24" FontAttributes="Bold" />
                    <Label Text="Plant logic viewer" FontSize="11" TextColor="{StaticResource MutedColor}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="BRIDGE" Style="{StaticResource UppercaseLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Grid>
                            <Picker x:Name="bridgePicker"
                                    Title="Saved bridges"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="OnBridgePicked" />
                            <Label Text="▾"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedColor}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InputBorder}">
                        <Entry x:Name="hostEntry"
                               BackgroundColor="Transparent"
                               Placeholder="10.3.1.50 or http://10.3.1.50:8080" />
                    </Border>
                    <Border Style="{StaticResource InputBorder}">
                        <Entry x:Name="nameEntry"
                               BackgroundColor="Transparent"
                               Placeholder="Name (optional, e.g. Line 1)" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="connectButton"
                                Text="Add &amp; connect"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnConnectClicked" />
                        <Button x:Name="cancelConnectButton"
                                Grid.Column="1"
                                Text="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                VerticalOptions="Center"
                                Clicked="OnCancelConnectClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <ActivityIndicator x:Name="busyIndicator"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           Color="{StaticResource GoodColor}"
                                           IsRunning="False"
                                           IsVisible="False"
                                           VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="statusLabel"
                               FontSize="11"
                               TextColor="{StaticResource MutedColor}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACCOUNT" Style="{StaticResource UppercaseLabel}" />
                    <Label Text="Asked for a bridge account every time the viewer starts."
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry x:Name="userEntry"
                               BackgroundColor="Transparent"
                               Placeholder="Username" />
                    </Border>
                    <Border Style="{StaticResource InputBorder}">
                        <Entry x:Name="passwordEntry"
                               BackgroundColor="Transparent"
                               Placeholder="Password"
                               IsPassword="True" />
                    </Border>
                    <Button x:Name="signInButton"
                            Text="Sign in"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSignInClicked" />
                    <Label x:Name="errorLabel"
                           FontSize="12"
                           TextColor="{StaticResource BadColor}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label Text="One live bridge at a time · last known data stays readable offline."
                   FontSize="10"
                   TextColor="{StaticResource MutedColor}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
