<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpcBridge.Mobile.Views.LoginPage"
             Title="Sign in"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,20" Spacing="14">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border Style="{StaticResource LogoBorder}">
                    <Label Text="OB"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GoodColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="OpcBridge" FontSize="24" FontAttributes="Bold" />
                    <Label Text="Plant logic viewer" FontSize="11" TextColor="{StaticResource MutedColor}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="BRIDGE" Style="{StaticResource UppercaseLabel}" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label x:Name="bridgeStateDot"
                                   Text="●"
                                   FontSize="7"
                                   TextColor="{StaticResource MutedColor}"
                                   VerticalOptions="Center" />
                            <Label x:Name="bridgeStateLabel"
                                   Text="no bridge"
                                   FontSize="9.5"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource MutedColor}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBridgeRowTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Padding="12,0">
                            <Label Text="◈"
                                   FontSize="15"
                                   TextColor="{StaticResource MutedColor}"
                                   VerticalOptions="Center" />
                            <Label x:Name="bridgePickerLabel"
                                   Grid.Column="1"
                                   Text="Saved bridges"
                                   FontSize="13"
                                   TextColor="{StaticResource MutedColor}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="▾"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="⌂"
                                   FontSize="15"
                                   TextColor="{StaticResource MutedColor}"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="hostEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="10.3.1.50 or http://10.3.1.50:8080" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="✎"
                                   FontSize="14"
                                   TextColor="{StaticResource MutedColor}"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="nameEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Name (optional, e.g. Line 1)" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="connectButton"
                                Text="Add &amp; connect"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnConnectClicked" />
                        <Button x:Name="cancelConnectButton"
                                Grid.Column="1"
                                Text="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                VerticalOptions="Center"
                                Clicked="OnCancelConnectClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <ActivityIndicator x:Name="busyIndicator"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           Color="{StaticResource GoodColor}"
                                           IsRunning="False"
                                           IsVisible="False"
                                           VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="statusLabel"
                               FontFamily="monospace"
                               FontSize="9.5"
                               TextColor="{StaticResource MutedColor}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACCOUNT" Style="{StaticResource UppercaseLabel}" />
                    <Label Text="Asked for a bridge account every time the viewer starts."
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="◉"
                                   FontSize="15"
                                   TextColor="{StaticResource MutedColor}"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="userEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Username" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="•••"
                                   FontSize="9"
                                   TextColor="{StaticResource MutedColor}"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="passwordEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Password"
                                   IsPassword="True" />
                        </Grid>
                    </Border>
                    <Button x:Name="signInButton"
                            Text="Sign in"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSignInClicked" />
                    <Label x:Name="errorLabel"
                           FontSize="12"
                           TextColor="{StaticResource BadColor}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
                <Label Text="◉"
                       FontSize="10"
                       TextColor="{StaticResource MutedColor}"
                       VerticalOptions="Start"
                       Margin="0,1,0,0" />
                <Label Grid.Column="1"
                       Text="One live bridge at a time · last known data stays readable offline"
                       FontSize="9.5"
                       TextColor="{StaticResource MutedColor}"
                       LineBreakMode="WordWrap" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
