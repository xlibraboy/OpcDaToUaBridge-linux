<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:OpcBridge.Mobile"
             xmlns:views="clr-namespace:OpcBridge.Mobile.Views"
             x:Class="OpcBridge.Mobile.Views.LoginPage"
             Title="Sign in"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{theme:ThemeColor PageBg}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20,8,20,16" Spacing="14">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border Style="{StaticResource LogoBorder}">
                    <Image Source="{theme:ThemeIcon icon_workflow}"
                           WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="OpcBridge" FontSize="24" FontAttributes="Bold" />
                    <Label Text="Plant logic viewer" FontSize="11" TextColor="{theme:ThemeColor MutedColor}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="BRIDGE" Style="{StaticResource UppercaseLabel}" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <BoxView x:Name="bridgeStateDot"
                                     WidthRequest="6"
                                     HeightRequest="6"
                                     CornerRadius="3"
                                     Color="{theme:ThemeColor MutedColor}"
                                     VerticalOptions="Center" />
                            <Label x:Name="bridgeStateLabel"
                                   Text="no bridge"
                                   FontSize="9.5"
                                   FontAttributes="Bold"
                                   TextColor="{theme:ThemeColor MutedColor}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   MaximumWidthRequest="220" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBridgeRowTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Padding="12,0">
                            <Image Source="{theme:ThemeIcon icon_radio_tower}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   VerticalOptions="Center" />
                            <Label x:Name="bridgePickerLabel"
                                   Grid.Column="1"
                                   Text="Saved bridges"
                                   FontSize="13"
                                   TextColor="{theme:ThemeColor MutedColor}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="2"
                                   Source="{theme:ThemeIcon icon_chevron_down}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <!-- New bridge opens its own card below; picking a saved bridge never
                         sits beside the Add & connect button. -->
                    <Border BackgroundColor="{theme:ThemeColor PageBg}"
                            Stroke="{theme:ThemeColor BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0"
                            HeightRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewBridgeTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image Source="{theme:ThemeIcon icon_plus}"
                                   WidthRequest="14"
                                   HeightRequest="14"
                                   VerticalOptions="Center" />
                            <Label Text="New bridge…"
                                   FontSize="13"
                                   TextColor="{theme:ThemeColor MutedColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Shown only while the bridge is unreachable: the synced structure can be
                         read without an account, and the view is read-only. -->
                    <Button x:Name="viewOfflineButton"
                            Text="View offline data"
                            Style="{StaticResource SecondaryButton}"
                            IsVisible="False"
                            Clicked="OnViewOfflineClicked" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <ActivityIndicator x:Name="busyIndicator"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           Color="{theme:ThemeColor GoodColor}"
                                           IsRunning="False"
                                           IsVisible="False"
                                           VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="statusLabel"
                               FontFamily="monospace"
                               FontSize="9.5"
                               TextColor="{theme:ThemeColor MutedColor}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="addBridgeCard"
                    Style="{StaticResource CardBorder}"
                    IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="ADD A BRIDGE" Style="{StaticResource UppercaseLabel}" VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                Style="{StaticResource SmallActionBorder}"
                                SemanticProperties.Description="Hide the add-bridge form">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHideAddTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="{theme:ThemeIcon icon_x}"
                                   WidthRequest="14"
                                   HeightRequest="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_server}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="hostEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="10.3.1.50 or http://10.3.1.50:8080" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_tag}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="nameEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Name (optional, e.g. Line 1)" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="connectButton"
                                Text="Add &amp; connect"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnConnectClicked" />
                        <Button x:Name="cancelConnectButton"
                                Grid.Column="1"
                                Text="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                VerticalOptions="Center"
                                Clicked="OnCancelConnectClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="ACCOUNT" Style="{StaticResource UppercaseLabel}" VerticalOptions="Center" />
                        <Image Grid.Column="1"
                               Source="{theme:ThemeIcon icon_lock}"
                               WidthRequest="13"
                               HeightRequest="13"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Needed for live data. The synced plant structure stays readable offline without an account."
                           FontSize="11"
                           TextColor="{theme:ThemeColor MutedColor}"
                           LineBreakMode="WordWrap" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_user}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="userEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Username" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{theme:ThemeIcon icon_lock}"
                                   WidthRequest="15"
                                   HeightRequest="15"
                                   Margin="12,0,9,0"
                                   VerticalOptions="Center" />
                            <Entry x:Name="passwordEntry"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   BackgroundColor="Transparent"
                                   Placeholder="Password"
                                   IsPassword="True" />
                        </Grid>
                    </Border>
                    <Button x:Name="signInButton"
                            Text="Sign in"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSignInClicked" />
                    <Label x:Name="errorLabel"
                           FontSize="12"
                           TextColor="{theme:ThemeColor BadColor}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="20,4,20,16">
            <Image Source="{theme:ThemeIcon icon_shield_check}"
                   WidthRequest="13"
                   HeightRequest="13"
                   VerticalOptions="Start"
                   Margin="0,2,0,0" />
            <Label Grid.Column="1"
                   Text="One live bridge at a time · last known data stays readable offline"
                   FontSize="9.5"
                   TextColor="{theme:ThemeColor MutedColor}"
                   LineBreakMode="WordWrap" />
        </Grid>
        <views:BridgePickerSheet x:Name="bridgeSheet" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
